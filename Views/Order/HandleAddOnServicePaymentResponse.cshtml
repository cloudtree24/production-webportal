    .plan-toggle-group {
    display: flex;
    background: #f1f5f9;
    padding: 0.5rem;
    border-radius: 50px;
    gap: 0.5rem;
    }

    /* Buttons */
    .plan-toggle-group .plan-btn {
    padding: 0.6rem 1.4rem;
    border-radius: 30px;
    font-weight: 600;
    font-size: 0.95rem;
    color: #444;
    cursor: pointer;
    border: none;
    background: transparent;
    transition: all 0.35s ease;
    }

    /* Hover effect */
    .plan-toggle-group .plan-btn:hover {
    background: rgba(13, 110, 253, 0.08);
    color: #0d6efd;
    }

    /* Active state (selected) */
    .plan-toggle-group .btn-check:checked + .plan-btn {
    background: #0d6efd;
    color: #fff;
    box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    transform: translateY(-2px);
    }



