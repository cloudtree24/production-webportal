<script>
	$(document).ready(function () {
		// Event listener for when the modal is about to be shown
		$('#renewalModal').on('show.bs.modal', function (event) {
			const anchor = $(event.relatedTarget);
			const csorderId = anchor.data('order-id'); // Get the OrderId from the anchor tag
			const renewalid = anchor.data('renewal-id'); // Get the renewal from the anchor tag

			const modal = $(this);
			const loader = modal.find('#renewalLoader');
			const content = modal.find('#renewalContent');

			// 1. Show loader, hide content, and clear previous content
			content.hide().empty();
			loader.show();
			
			if (csorderId) {
				$.ajax({
					url: '@Url.Action("GetSubscriptionDetailsForRenewal", "Subscription")', // <<< UPDATE URL IF NEEDED
					type: 'GET', // Use GET since you're just retrieving data
					data: { CsOrderId: csorderId, RenewalId:renewalid },
					success: function (data) {
						// 2. Inject the returned Partial View HTML into the content area
						content.html(data);

						// 3. Hide loader, show content
						loader.hide();
						content.show();
					},
					error: function (xhr, status, error) {
						// Handle AJAX error
						content.html(`
							<div class="alert alert-danger" role="alert">
								Failed to load order details (ID: ${orderId}). Please try again.
								<p class="small mt-2">Error: ${status} - ${error}</p>
							</div>
						`);
						loader.hide();
						content.show();
						console.error("AJAX Error:", error);
					}
				});
			} else {
				// Handle case where OrderId is missing
				content.html('<div class="alert alert-warning" role="alert">Order ID not found. Cannot load details.</div>');
				loader.hide();
				content.show();
			}
		});
	});
</script>
<script>
	




	$('.generate-invoice-btn').on('click', function (e) {
						

			e.preventDefault(); // Prevent the default link behavior
			
			var csorderId = $(this).data('csorder-id');
			var recordType = $(this).data('record-type');
			// var customerId = $(this).data('customer-id');

			// Show a loading indicator
			$('#invoiceModalBody').html('<div class="d-flex justify-content-center align-items-center" style="height: 300px;"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>');
			$('#generateInvoiceModal').modal('show');

			// Make an AJAX call to the InvoicePrint action
			$.ajax({
				url: '@Url.Action("InvoicePrint", "Order")',
				type: 'GET',
				data: {
					Id: csorderId,
					RecordType: recordType,
					// CustomerId: customerId
				},
				success: function (result) {
					// On success, inject the partial view content into the modal body
					$('#invoiceModalBody').html(result);
				},
				error: function (xhr) { // Renamed 'errorMessage' to 'xhr' for clarity

			// 1. Get the specific error message from the controller's BadRequest response
			var specificErrorMessage = xhr.responseText || 'again.';

			// 2. Build the HTML with the specific message and the "Ok" button
			var htmlContent =
				'<div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">' +
					// Use a div to contain the message text
					'<div class="me-3"><strong>Error:</strong> ' + specificErrorMessage + '</div>' +

					// Use a standard Bootstrap button styled as primary/danger
					'<button type="button" class="btn btn-sm btn-danger" ' +
					// The onclick event closes the main modal
					'onclick="$(\'#generateInvoiceModal\').modal(\'hide\');">' +
						'Ok' +
					'</button>' +
				'</div>';

			// Inject the error message and button into the modal body
			$('#invoiceModalBody').html(htmlContent);
		}
			});
		});
</script>