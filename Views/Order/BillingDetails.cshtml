@using HCMPortal.ViewModel
@model List<HCMPortal.ViewModel.CustomerOrderDetails>
@{
	ViewData["Title"] = "BillingDetails";
	Layout = "~/Views/Shared/_customerDashboardLayout.cshtml";
}

<section class="breadcumnd__banner">
	<!--Container-->
	<div class="container">
		<div class="d-flex justify-content-start gap-4">
			<h2 class="bread__title">
				Billing & Invoicing
			</h2>
			<ul class="breadcumnd__link">
				<li>
					<a asp-controller="CustomerManagement" asp-action="PortalDashboard">Dashboard</a>
				</li>
				<li><i class="bi bi-chevron-right"></i></li>
				<li class="active">
					<a href="javascript:void(0)">Billing & Invoicing</a>
				</li>
			</ul>
		</div>
	</div>
	<!--Container-->
</section>

<div class="section_gap_large">

	<section class="dashboad_center billing-section">

		<div class="container-fluid px-4">
			<div class="row g-4">
				@{
					int userid = Convert.ToInt32(Context.Session.GetInt32("UserId"));
				}

				@{
					List<CustomerOrderDetails> renewalData = new List<CustomerOrderDetails>();

					renewalData =
					
					//for check already customer renew or Upgrade a new one--Anshuman 23.09.2026
					(Model.Any(e=>e.RecordType=="Renewal"))?new List<CustomerOrderDetails>()
							:Model.Where(e =>
					e.SubscriptionEndDate.HasValue && (

					(e.RecordType == "Subscription"
					&& e.SubscriptionEndDate.Value.Date.AddDays(
					(e.BillingName == "Monthly") ? -7 :
					(e.BillingName == "Yearly") ? -30 : -15
					) <= DateTime.Now.Date
					&& DateTime.Now.Date < e.SubscriptionEndDate.Value.Date)

					||

					(e.RecordType == "Renewal"
					&& e.SubscriptionEndDate.Value.Date.AddDays(
					(e.BillingName == "Monthly") ? -7 :
					(e.BillingName == "Yearly") ? -30 : -15
					) <= DateTime.Now.Date
					&& DateTime.Now.Date < e.SubscriptionEndDate.Value.Date)

					||

					((e.RecordType == "Subscription" || e.RecordType == "Renewal")
					&& DateTime.Now.Date >= e.SubscriptionEndDate.Value.Date)

					)
					).ToList();

					var renewedPreviousOrderIds = Model
					.Where(e =>
					e.RecordType == "Renewal" &&
					e.SubscriptionStartDate.HasValue &&
					e.SubscriptionStartDate.Value.Date > DateTime.Now.Date
					)
					.Select(e => e.CsorderId)
					.Distinct()
					.ToList()
					;

					renewalData = renewalData
					.Where(e => !renewedPreviousOrderIds.Contains(e.CsorderId))
					.ToList();
				}

				@if (Model.Any(e => e.OrderStatus == "Pending") || renewalData.Count() > 0)
				{
					<div class="col-xl-4 col-lg-5 col-md-12 mb-4">

						<h4 class="mb-4">Pending Info</h4>

						<div class="card shadow-sm">
							<div class="card-body p-3 style=" overflow-x: auto;"">
								<table class="table align-middle custom-table mb-0" style="width: 100%; min-width: 300px;">

									<thead>
										<tr>
											<th>Service/s</th>
											<th>Amount</th>
											<th>Renewal Date</th>
											<th class="text-end">Action</th>
										</tr>
									</thead>

									<tbody>

										@foreach (var item in Model.Where(e => e.OrderStatus == "Pending"))
										{
											string[] subscription = item.SubscriptionName?.Split("-") ?? new string[] { "NA" };

											string PlanName = "";
											string BillingName = "";

											if (subscription.Length > 1)
											{
												PlanName = subscription[0];
												BillingName = subscription[1];
											}
											else
											{
												PlanName = item.SubscriptionName ?? "";
											}

											string renewalDate = item.SubscriptionEndDate.HasValue
											? item.SubscriptionEndDate.Value.ToString("dd-MM-yyyy")
											: "Not Available";

											<tr>

												<td>
													@PlanName@(!String.IsNullOrEmpty(BillingName) ? "/" + BillingName : "")
												</td>

												<td>
													₹@item.NetAmount
												</td>

												<td>
													@renewalDate
												</td>

												<td class="text-end">

													@Html.ActionLink(
													"Pay Now",
																						"PaymentRequestHandleFromAMS",
																						"CustomerManagement",
																						new
																						{
																							orderNumber = item.OrderId,
																							invoiceNumber = item.InvoiceId,
																							csid = userid,
																							orderType = item.OrderType
																						},
																						new
																						{
																							@class = "btn btn-primary btn-sm no-print text-nowrap" // Text overlap na ho isliye text-nowrap use kiya
																						})

										</td>

									</tr>
																		}

										@foreach (var item in renewalData)
										{
											string[] subscription = item.SubscriptionName?.Split("-") ?? new string[] { "NA" };

											string PlanName = "";
											string BillingName = "";

											if (subscription.Length > 1)
											{
												PlanName = subscription[0];
												BillingName = subscription[1];
											}
											else
											{
												PlanName = item.SubscriptionName ?? "";
											}

											string renewalDate = item.SubscriptionEndDate.HasValue
											? item.SubscriptionEndDate.Value.ToString("dd-MM-yyyy")
											: "Not Available";

											string ExpiredStatus =
											(item.SubscriptionEndDate.HasValue &&
											item.SubscriptionEndDate.Value.Date < DateTime.Now.Date)
											? "Expired"
											: "";

											<tr>

												<td>
													@PlanName@(!String.IsNullOrEmpty(BillingName) ? "/" + BillingName : "")
												</td>

												<td>
													₹@item.NetAmount
												</td>

												<td>
													@renewalDate

													@if (!String.IsNullOrEmpty(ExpiredStatus))
													{
														<br />
														<span class="badge bg-danger mt-1">
															@ExpiredStatus
														</span>
													}

												</td>

												<td class="text-end">

													@if (!String.IsNullOrEmpty(BillingName))
													{
														<a href="#"
														   class="btn btn-primary btn-sm no-print btn-renew text-nowrap"
														   data-bs-toggle="modal"
														   data-bs-target="#renewalModal"
														   data-order-id="@item.CsorderId"
														   data-renewal-id="@item.SubscriptionRenewalId">

															Renew Now

														</a>
													}
													else
													{
														@Html.ActionLink(
														"Pay Now",
																						"PaymentRequestHandleFromAMS",
																						"CustomerManagement",
																						new
																						{
																							orderNumber = item.OrderId,
																							invoiceNumber = item.InvoiceId,
																							csid = userid,
																							orderType = item.RecordType
																						},
																						new
																						{
																							@class = "btn btn-primary btn-sm no-print text-nowrap"
																						})
																						}

												</td>

											</tr>
										}

									</tbody>

								</table>

							</div>

						</div>

					</div>
				}

				<div class="@((Model.Any(e => e.OrderStatus == "Pending") || renewalData.Count() > 0) ? "col-xl-8 col-lg-7 col-md-12" : "col-12")">

					<h4 class="mb-4">Transaction History</h4>

					<div class="card shadow-sm">

						<div class="card-body p-3" style="overflow-x: auto;">
							<table class="table align-middle custom-table mb-0" style="width: 100%; min-width: 600px;">

								<thead>
									<tr>
										<th>Invoice Number</th>
										<th>Service/s</th>
										<th>Amount</th>
										<th>Invoice Date</th>
										<th>Order Status</th>
										<th class="text-end">Action</th>
									</tr>
								</thead>

								<tbody>

									@if (Model != null)
									{
										foreach (var item in Model.Where(e => e.OrderStatus == "Completed"))
										{
											<tr>

												<td>
													@item.InvoiceId
												</td>

												<td>
													@item.SubscriptionName
												</td>

												<td>
													₹@item.NetAmount
												</td>

												<td>
													@((item.TransactionDate.HasValue)
																								? item.TransactionDate.Value.ToString("dd-MM-yyyy")
																								: "NA")
										</td>

												<td>

											@if (item.OrderStatus == "Completed")
													{
														<span class="badge bg-success">
															Paid
														</span>
													}
													else if (item.OrderStatus == "Pending")
													{
														<span class="badge bg-info">
															Pending
														</span>
													}
													else
													{
														<span class="badge bg-warning">
															Failed
														</span>
													}

												</td>

												<td class="text-end">

													<a href="javascript:void(0);"
													   class="btn btn-outline-primary btn-sm generate-invoice-btn text-nowrap"
													   data-csorder-id="@item.CsorderId"
													   data-record-type="@item.RecordType">

														<i class="bi bi-printer"></i>
														Print Invoice

													</a>

												</td>

											</tr>
										}
									}

								</tbody>

							</table>

						</div>

					</div>

				</div>

			</div>

		</div>

	</section>

</div>


<div class="main">
	<div class="green-line"></div>
</div>


