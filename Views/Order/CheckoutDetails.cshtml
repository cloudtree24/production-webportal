         $("#dPlanId").change(function () {
        var planId = $(this).val();
        var sid = $("#sid").val();
        var planName = $("#dPlanId option:selected").text().trim(); // ✅ get plan name dynamically

        if (!planId) {
            $("#subscriptionContainer").html("");
            return;
        }

        $.ajax({
            url: '/Order/GetSubscriptionsByPlanId',
            type: 'GET',
            data: { planId: planId,sid:sid },
            success: function (subscriptions) {
                var html = '';

                if (subscriptions && subscriptions.length > 0) {
                    $.each(subscriptions, function (index, sub) {
                        // ✅ Calculate monthly equivalent based on plan type
                        var monthlyValue = sub.amount; // default
                        var planLabel = "Month";

                        if (planName.toLowerCase().includes("year")) {
                            monthlyValue = sub.amount / 12;
                            planLabel = "Yearly";
                        } else if (planName.toLowerCase().includes("quarter")) {
                            monthlyValue = sub.amount / 3;
                            planLabel = "Quarterly";
                        } else if (planName.toLowerCase().includes("half")) {
                            monthlyValue = sub.amount / 6;
                            planLabel = "Half-Year";
                        } else if (planName.toLowerCase().includes("month")) {
                            planLabel = "Monthly";
                        }

                        // Split feature list
                        var features = '';
                        if (sub.details) {
                            var featureList = sub.details.split('.');
                            $.each(featureList, function (i, feature) {
                                if (feature.trim() !== '') {
                                    features += `
                                        <li class="d-flex align-items-center mb-2">
                                            <span class="pricing-check me-2">
                                                <i class="bi bi-patch-check-fill text-primary"></i>
                                            </span>${feature.trim()}
                                        </li>`;
                                }
                            });
                        }

                        html += `
                            <div class="col-md-6">
                                <div class="card mb-3 rounded-custom">
                                    <div class="card-body">
                                        <h4 class="mb-1">${sub.subscriptionName}
                                            <span>₹${sub.amount.toFixed(2)}</span>
                                            <span class="d-inline-flex ms-1">/ ${planLabel}</span>
                                        </h4>
                                        ${planLabel !== "Month" ?
                                            `<b><p class="text-muted mb-1">(≈ ₹${monthlyValue.toFixed(2)} per month)</p></b>`
                                            : ""}
                                        <p class="mb-0">Feature for up to ${sub.maximumMemberCount} users</p>
                                        <ul>${features}</ul>
                                            <a href="#"
                                               class="btn btn-primary btn-lg w-100 mb-3 select-plan-btn"
                                               data-sid="${sub.sid}"
                                               data-pid="${planId}"
                                                data-subscription="${sub.subscriptionName}"
                                                 data-planname="${planName}">
                                               Select
                                            </a>
                                                                           
                                      </div>
                                </div>
                            </div>`;
                    });
                } else {
                    html = '<p class="text-muted">No subscriptions found for this plan.</p>';
                }

                $("#subscriptionContainer").html(html);
            },
            error: function (xhr, status, error) {
                console.error("Error fetching subscriptions:", error);
                $("#subscriptionContainer").html('<p class="text-danger">Error loading subscriptions.</p>');
            }
        });
    });
    });

