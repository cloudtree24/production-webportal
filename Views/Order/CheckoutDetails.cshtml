                        // }

                        // decimal cgstAmount = (baseAmount * cgstPercentage) / 100;
                        // decimal sgstAmount = (baseAmount * sgstPercentage) / 100;
                        // decimal igstAmount = (baseAmount * igstPercentage) / 100;
                        decimal gstAmount = (baseAmount * gstPercentage) / 100;
                        decimal totalAmount = baseAmount + gstAmount;
                        // decimal totalAmount = baseAmount + cgstAmount + sgstAmount + igstAmount;
                    }

                    <div class="card mb-3 rounded-custom">
                        <div class="card-body">
                            <div class="d-flex flex-column">
                                <div class="d-flex justify-content-between mb-2">
                                    <p class="mb-0">Amount</p>
                                    <p class="mb-0" id="baseAmount">₹@baseAmount</p>
                                </div>

                                @{
                                    if(Model?.SelectedSubscription?.PerpackCount>0 && Model.SelectedSubscription?.PackCost>0)
                                    {
                                        <div class="mb-4">

                                            <div class="row bg-light p-3 rounded">

                                                <div class="col-md-12 d-flex">
                                                    <i class="bi bi-person-plus-fill text-primary me-2"></i>
                                                    <p class="d-flex flex-column">
                                                        <span class="fs-5 fw-bold text-dark lh-1 mb-1">Add-Ons</span>
                                                        <small class="text-muted fw-normal">Additional User Packs</small>
                                                    </p>
                                                </div>

                                                <div class="col-md-4">
                                                    <!-- Packs -->
                                                    <div class="text-center mb-4">
                                                        <div class="stat-label mb-2">Packs</div>
                                                        <div class="counter-wrapper d-inline-flex align-items-center">
                                                            <button class="btn btn-outline-primary btn-circle btn-sm" onclick="calc(-1, @Model?.SelectedSubscription?.PerpackCount, @Model?.SelectedSubscription?.PackCost)">
                                                                -
                                                            </button>
                                                            <span class="px-4 fw-bold fs-5" id="pCount">0</span>
                                                            <button class="btn btn-outline-primary btn-circle btn-sm" onclick="calc(1, @Model?.SelectedSubscription?.PerpackCount, @Model?.SelectedSubscription?.PackCost)">
                                                                +
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-4">
                                                    <!-- Total Users -->
                                                    <div class="text-center mb-4">
                                                        <div class="stat-label mb-1">Total Users</div>
                                                        <div class="fw-bold fs-4 text-dark">
                                                            <span id="uCount">0</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-4">
                                                    <!-- Pack Cost -->
                                                    <div class="text-center">
                                                        <div class="stat-label mb-1">Pack Cost</div>
                                                        <div class="fw-bold fs-5 text-success">
                                                            ₹<span id="pCost">0.00</span>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                



                                <div class="d-flex justify-content-between mb-2">
                                    <p class="mb-0 text-success">Discount </p>
                                    <p class="mb-0 text-success" id="discountValue">₹0</p>
                                </div>
                               @*  @if (cgstPercentage > 0)
