<script>
    var newCompanyDetails = null;

    $(document).ready(function () {

        var isSubscriptionActive =
            @((Model?.issubscriptionActive ?? false).ToString().ToLower());

        /* SHOW MODAL */
        if (isSubscriptionActive) {
            new bootstrap.Modal(
                document.getElementById('subscriptionActiveModal'),
                { backdrop: 'static', keyboard: false }
            ).show();
        }

        /* CANCEL */
        $("#cancelSubscriptionModal").on("click", function () {
            window.location.href =
                '@Url.Action("SubscriptionDetails", "Subscription")';
        });

        /* SAVE (MODAL FORM SUBMIT) */
        $("#subscriptionModalForm").on("submit", function (e) {
            e.preventDefault();

            var form = $(this);

            form.removeData("validator");
            form.removeData("unobtrusiveValidation");
            $.validator.unobtrusive.parse(form);

            if (!form.valid()) {
                return false;
            }

            // ✅ COLLECT ALL VALUES
            newCompanyDetails = {
                OrganisationName: $("#modalorgName").val(),
                EmailAddress: $("#modalemailId").val(),
                PhoneNumber: $("#modalphoneNumber").val(),
                Gstin: $("#modalGSTIN").val(),
                Pan: $("#modelPan").val(),
                CountryId: $("#ddlCountry").val(),
                StateId: $("#ddlState").val(),
                City: $("#modal_city").val(),
                PostalCode: $("#modal_postal_code").val(),
                Address: $("#modal_address").val()
            };

            $("#newCompanyDetails").val(JSON.stringify(newCompanyDetails));

            vt.success("Details saved successfully", {
                position: "top-center",
                duration: 2000
            });

            bootstrap.Modal.getInstance(
                document.getElementById('subscriptionActiveModal')
            ).hide();

            return false;
        });

        /* FINAL PAYMENT SUBMIT */
        $("#razorpayForm").on("submit", function (e) {

            if (!isSubscriptionActive) return true;

            var modalForm = $("#subscriptionModalForm");

            modalForm.removeData("validator");
            modalForm.removeData("unobtrusiveValidation");
            $.validator.unobtrusive.parse(modalForm);

            if (!modalForm.valid()) {
                e.preventDefault();

                vt.error("Please complete subscription details.", {
                    position: "top-center",
                    duration: 2000
                });

                new bootstrap.Modal(
                    document.getElementById('subscriptionActiveModal'),
                    { backdrop: 'static', keyboard: false }
                ).show();

                return false;
            }

            if (!newCompanyDetails) {
                e.preventDefault();
                vt.error("Please click Save before proceeding.", {
                    position: "top-center",
                    duration: 2000
                });
                return false;
            }

            // ✅ MERGE JSON
            var model = JSON.parse($("input[name='jsonData']").val());

            model.PortalCustomerDetails.CompanyName   = newCompanyDetails.OrganisationName;
            model.PortalCustomerDetails.EmailAddress  = newCompanyDetails.EmailAddress;
            model.PortalCustomerDetails.Phonenumber   = newCompanyDetails.PhoneNumber;
            model.PortalCustomerDetails.Gstinnumber   = newCompanyDetails.Gstin;
            model.PortalCustomerDetails.Pancard       = newCompanyDetails.Pan;
            model.PortalCustomerDetails.City          = newCompanyDetails.City;
            model.PortalCustomerDetails.CountryId     = newCompanyDetails.CountryId;
            model.PortalCustomerDetails.StateId       = newCompanyDetails.StateId;
            model.PortalCustomerDetails.Address       = newCompanyDetails.Address;
            model.PortalCustomerDetails.PostalCode    = newCompanyDetails.PostalCode;

            $("input[name='jsonData']").val(JSON.stringify(model));
            return true;
        });

    });
</script>



