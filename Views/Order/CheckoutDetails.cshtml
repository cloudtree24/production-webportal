                                    <button class="btn btn-outline-primary ms-2" id="btnApplyDiscount" type="button">Apply</button>
                                </div>
                            </div>
                        </div>
                    </div>

                   
                </div>
                
                <div class="d-flex flex-column gap-2">
                    
