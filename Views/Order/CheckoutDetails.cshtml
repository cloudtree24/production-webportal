@using Newtonsoft.Json
@model HCMPortal.ViewModel.OrderDetailViewModel
@{
    ViewData["Title"] = "CheckoutDetails";
    Layout = "~/Views/Shared/_customerDashboardLayout.cshtml";
}

@if (TempData["PaymentError"] != null)
{
    <script>
        alert('@TempData["PaymentError"]');
    </script>
}

<script src="~/assets/js/jquery.min.js"></script>
<script src="~/assets/js/vanilla-toast.min.js"></script>
<style>
    .custom-modal {
        border-radius: 1rem;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        overflow: hidden;
        animation: fadeInScale 0.3s ease-out;
    }

  

    /* Gradient button */
    .btn-gradient {
        background: linear-gradient(90deg, #007bff, #00c6ff);
        color: white;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-gradient:hover {
            background: linear-gradient(90deg, #0062cc, #0096d6);
            box-shadow: 0 4px 12px rgba(0, 123, 255, 0.4);
            transform: translateY(-1px);
        }

</style>
<!-- Breadcrumb -->
<section class="breadcumnd__banner">
    <!--Container-->
    <div class="container">
        <div class="d-flex justify-content-start gap-4">
            <h2 class="bread__title">
                Checkout
            </h2>
            <ul class="breadcumnd__link">
                <li>
                    @* <a href="https://www.thecloudtree.ai/human-resources">Home</a> *@
                    <a asp-route="CustomerDashboard">Home</a>
                </li>
                <li><i class="bi bi-chevron-right"></i></li>
                <li class="active">
                    <a href="javascript:void(0)">Checkout</a>
                </li>
            </ul>
        </div>
    </div>
    <!--Container-->
</section>
