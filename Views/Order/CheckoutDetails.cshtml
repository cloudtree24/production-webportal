<div class="section_gap_large">
    <div class="container">
       
        <div class="row">
            <!-- Left Side: Order Details Cards -->
            <div class="col-md-4 order-2 order-md-1">
                <div class="order-details">
                    <h4 class="mb-3">Order Details</h4>
                    <!-- Card 1: Order Number, Order Date, Full Name, Email Address, Company, Billing Address -->
                    <div class="card mb-3 rounded-custom">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <p class="mb-0 fs-6 text-muted">Order Number : </p>
                                <p class="mb-0">@Model?.OrderId</p>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <p class="mb-0 fs-6 text-muted">Order Date : </p>
                                @* <p class="mb-0">@DateTime.Now.Date</p> *@
                                <p class="mb-0">@DateTime.Now.ToString("dd-MM-yyyy hh:mm tt")</p>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <p class="mb-0 fs-6 text-muted">Full Name : </p>
                                <p class="mb-0">@Model?.PortalCustomerDetails?.ContactPersonName</p>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <p class="mb-0 fs-6 text-muted">Email Address : </p>
                                <p class="mb-0">@Model?.PortalCustomerDetails?.EmailAddress</p>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <p class="mb-0 fs-6 text-muted">Company : </p>
                                <p class="mb-0">@Model?.PortalCustomerDetails?.CompanyName</p>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <p class="mb-0 fs-6 text-muted">Billing Address : </p>
                                <p class="mb-0">@Model?.PortalCustomerDetails?.Address</p>
                            </div>
                        </div>
                    </div>
                    <!-- Card 2: Base Amount, GST, Total -->
                    @{
                        decimal baseAmount = Model?.SelectedSubscription?.Amount ?? 0;
                        decimal gstPercentage = Convert.ToDecimal(Model?.TaxPercentage ?? 0);

                        decimal cgstPercentage = 0;
                        decimal sgstPercentage = 0;
                        decimal igstPercentage = 0;

                        // if (Model?.PortalCustomerDetails?.StateId == 10)
                        // {
                        //     // Intra-state → CGST + SGST
                        //     cgstPercentage = gstPercentage / 2;
                        //     sgstPercentage = gstPercentage / 2;
                        //     igstPercentage = 0;
                        // }
                        // else
                        // {
                        //     // Inter-state → IGST
                        //     cgstPercentage = 0;
