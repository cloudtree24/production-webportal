@model HCMPortal.Models.RazorpayCheckoutViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Subscription Checkout</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

    <!-- Loader -->
    <div id="loader" style="position: fixed; inset: 0; background: rgba(255,255,255,0.9); display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 20px; z-index: 9999;">
        <img src="@Url.Content("~/assets/images/logos/cloudtree-logo.webp")" style="width:120px;" />
        <div class="spinner-border" style="width:4rem;height:4rem;"></div>
        <h4 class="mt-3">Redirecting to subscription payment...</h4>
    </div>

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <!-- Hidden Form -->
    <form method="post" action="/Order/RazorpayPaymentSuccess" id="razorpay-form">
        <input type="hidden" name="razorpay_payment_id" id="razorpay_payment_id" />
        <input type="hidden" name="razorpay_subscription_id" id="razorpay_subscription_id" />
        <input type="hidden" name="razorpay_signature" id="razorpay_signature" />
    </form>

    <script>
        var options = {
            "key": "@Model.Key",
            "subscription_id": "@Model.SubscriptionId",
            "name": "CLOUDTREE AI INDIA PRIVATE LIMITED",
            "description": "Subscription Payment",
            "image": "@Url.Content("~/assets/images/logos/cloudtree-logo.webp")",
            "prefill": {
                 "name": "@Model.CustomerName",
                "email": "@Model.Email",
                "contact": "@Model.Phone"
            },

            "theme": {
                "color": "#145A32"
            },

            "handler": function (response) {
                document.getElementById("razorpay_payment_id").value = response.razorpay_payment_id;
                document.getElementById("razorpay_subscription_id").value = response.razorpay_subscription_id;
                document.getElementById("razorpay_signature").value = response.razorpay_signature;

                document.getElementById("razorpay-form").submit();
            },

            "modal": {
                "ondismiss": function () {
                    window.location.href = "/Order/PaymentFailure"
                        + "?status=cancelled"
                        + "&errorDescription=" + encodeURIComponent("User closed the payment window");
                }
            }
        };

        var rzp = new Razorpay(options);

        rzp.on('payment.failed', function (response) {
            window.location.href = "/Order/PaymentFailure"
                + "?status=failed"
                + "&errorDescription=" + encodeURIComponent(response.error.description)
                + "&errorCode=" + encodeURIComponent(response.error.code)
                + "&errorReason=" + encodeURIComponent(response.error.reason);
        });

        window.onload = function () {
            rzp.open();
        };
    </script>

</body>
</html>
