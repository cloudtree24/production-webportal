<script>
    const slotSelect = document.getElementById("slotSelect");
    const selectedSlotDiv = document.getElementById("selectedSlotTiming");
    
    if (slotSelect) {
    slotSelect.addEventListener("change", function () {
        const selected = this.value;

        if (!selected) {
            // Hide the alert if no slot is selected
            selectedSlotDiv.classList.add("d-none");
            return;
        }

        // Show the alert and update text
        selectedSlotDiv.classList.remove("d-none");
        selectedSlotDiv.innerHTML = "Selected: " + selected;
    });
    }
</script>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        $("#weeklySlotsBox").addClass("d-none");
        $("#selectedSlotTiming").addClass("d-none");

        // ✅ TODAY DATE AUTO SELECT
        if (!$("#slotDate").val()) {
            let today = new Date();
            let yyyy = today.getFullYear();
            let mm = String(today.getMonth() + 1).padStart(2, '0');
            let dd = String(today.getDate()).padStart(2, '0');

            let formattedDate = `${yyyy}-${mm}-${dd}`;
            $("#slotDate").val(formattedDate).trigger("change");
        }

        function parseDDMMYYYY(dateStr) {
            if (!dateStr) return null;

            const parts = dateStr.split("-");
            if (parts.length !== 3) return null;

            return new Date(parts[2], parts[1] - 1, parts[0]);
        }

        $("#slotDate").change(function () {

            let inputDate = $(this).val();

            // ❌ VALIDATION COMMENTED
            /*
            if (!inputDate) return;
            */

            
            let selectedDate = new Date(inputDate);

            // ❌ VALIDATION COMMENTED
            /*
            if (isNaN(selectedDate.getTime())) {
                console.error("Invalid date:", inputDate);
                return;
            }
            */

            let dayName = selectedDate.toLocaleDateString("en-US", { weekday: "long" });

            $.ajax({
                url: "/Order/GetSlotsByDay",
                type: "GET",
                data: {
                    dayName: dayName,
                    inputDate: inputDate
                },
                success: function (response) {

                    
                    $("#weeklySlotsBox").removeClass("d-none");
                    $("#slotContainer").empty();

                    if (!response || response.length === 0) {
                        $("#slotContainer").html(
                            "<p class='text-danger fw-bold'>No Slots Available</p>"
                        );
                        return;
                    }

                    response.forEach(slot => {

                        let start = convertToAmPm(slot.slotStartTime);
                        let end = convertToAmPm(slot.slotEndTime);

                        let btn = `
                            <button type="button"
                                    class="btn btn-outline-success btn-sm slot-btn"
                                    data-start="${start}"
                                    data-end="${end}"
                                    data-day="${slot.day}"
                                    data-slotid="${slot.slid}">
                                ${start} - ${end}
                            </button>`;

                        $("#slotContainer").append(btn);
                    });
                },
                error: function (err) {
                    console.error("Slot fetch error:", err);
                    $("#slotContainer").html(
                        "<p class='text-danger fw-bold'>Error loading slots</p>"
                    );
                }
            });

        });

        function convertToAmPm(timeString) {
            let time = timeString.split(":");
            let hour = parseInt(time[0]);
            let minutes = time[1];

            let suffix = hour >= 12 ? "PM" : "AM";
            hour = ((hour + 11) % 12 + 1);

            return `${hour}:${minutes} ${suffix}`;
        }

        function convertTo24Hour(time) {
            let [timePart, modifier] = time.split(" ");
            let [hours, minutes] = timePart.split(":");

            hours = parseInt(hours);

            if (modifier === "PM" && hours < 12) hours += 12;
            if (modifier === "AM" && hours === 12) hours = 0;

            return `${hours.toString().padStart(2, '0')}:${minutes}:00`;
        }

        $(document).on("click", ".slot-btn", function () {

            let start = $(this).data("start");
            let end = $(this).data("end");
            let day = $(this).data("day");
            let slotId = $(this).data("slotid");

            let converted = convertTo24Hour(start);

            $("#slottime").val(converted);
            $("#timeslotid").val(slotId);

            $("#selectedSlotTiming").removeClass("d-none");
            $("#finalSelectedText").text(`${day} | ${start} - ${end}`);

            $(".slot-btn").removeClass("active");
            $(this).addClass("active");
        });

    });
</script>
<script>

    function formatDate(dateStr) {
        if (!dateStr) return "";
        let d = new Date(dateStr);
        let day = String(d.getDate()).padStart(2, '0');
        let month = String(d.getMonth() + 1).padStart(2, '0');
        let year = d.getFullYear();
        return `${day}-${month}-${year}`;
    }

    $(document).ready(function () {

