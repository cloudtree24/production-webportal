        function isZeroTime(val) {
            if (!val) return true;
            val = val.toString().trim();
            return /^0{1,2}:\d{2}(:\d{2})?$/.test(val) && /^0{1,2}:[0]{2}(:[0]{2})?$/.test(val);
        }

        let initial = $(hiddenSlotSelector).val();
        if (isZeroTime(initial)) {
            $(hiddenSlotSelector).val("");
        }

        $(formSelector).on("submit", function (e) {

            

            let slotTime = $("#slottime").val();
            let selectedDate = $("#slotDate").val();

            // ❌ VALIDATION COMMENTED ONLY
            /*
