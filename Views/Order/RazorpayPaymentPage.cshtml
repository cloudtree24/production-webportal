@model HCMPortal.Models.RazorpayCheckoutViewModel
@{
    ViewData["Title"] = "RazorPay";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loader Preview</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: sans-serif;
        }
    </style>
</head>
<body>
    <div id="loader" style="position: fixed;inset: 0; background: rgba(255,255,255,0.9); display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 20px; z-index: 9999;">
        <img src="@Url.Content("~/assets/images/logo.png")" style="width: 120px; height: auto;" />
        <div class="spinner-border" style="width: 4rem; height: 4rem;"></div>
        <h4 class="mt-3">Please wait, processing your payment...</h4>
    </div>

</body>
</html>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
    var options = {
        "key": "@Model.Key",
        "amount": "@(Model.Amount * 100)",
        "currency": "INR",
        "name": "@Model.CustomerName",
        "description": "Subscription Payment",
        "order_id": "@Model.OrderId",  
        "handler": function (response) { window.location.href = "/Order/PaymentSuccess" + "?paymentId=" + response.razorpay_payment_id  + "&orderId=" + response.razorpay_order_id + "&razorpay_signature=" + response.razorpay_signature;
        },
        "modal": {
            "ondismiss": function () {
                window.location.href = "/Order/PaymentFailure"  + "?orderId=@Model.OrderId" + "&status=cancelled"  + "&errorDescription=User closed the payment window.";
            }
        },       
        "prefill": {
            "name": "@Model.CustomerName",
            "email": "@Model.Email",
            "contact": "@Model.Phone"
        },
        "theme": {
            "color": "#FFFFFF"
        }
    };
    var rzp = new Razorpay(options);   
    rzp.on('payment.failed', function (response) {
        window.location.href = "/Order/PaymentFailure"+ "?orderId=@Model.OrderId"  + "&status=failed"  + "&errorDescription=" + encodeURIComponent(response.error.description);
    });

    rzp.open();
</script>
