@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Service Unavailable</title>

    <style>
            :root {
                --primary-color: #2b5634;
                --primary-hover: #1e3f26;
                --text-heading: #1e293b;
                --text-body: #64748b;
                --bg-color: #f8fafc;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            }

            body {
                background-color: var(--bg-color);
                background-image: radial-gradient(#e2e8f0 1px, transparent 1px);
                background-size: 24px 24px;
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: 100vh;
                padding: 20px;
            }

            .card {
                width: 100%;
                max-width: 620px;
                background: #ffffff;
                padding: 48px 40px;
                border-radius: 24px;
                text-align: center;
                box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.07), 0 0 1px 1px rgba(0, 0, 0, 0.03);
                animation: fadeIn 0.5s ease-out forwards;
            }

            .brand-logo {
                max-width: 260px;
                height: auto;
                margin-bottom: 32px;
                object-fit: contain;
            }

            .status-badge {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background-color: #fef3c7;
                color: #92400e;
                padding: 6px 16px;
                border-radius: 50px;
                font-size: 13px;
                font-weight: 600;
                letter-spacing: 0.5px;
                text-transform: uppercase;
                margin-bottom: 20px;
            }

            .status-dot {
                width: 8px;
                height: 8px;
                background-color: #f59e0b;
                border-radius: 50%;
                animation: pulse 1.8s infinite;
            }

            h1 {
                color: var(--text-heading);
                margin-bottom: 12px;
                font-size: 28px;
                font-weight: 700;
                line-height: 1.3;
            }

            p {
                color: var(--text-body);
                font-size: 16px;
                margin-bottom: 36px;
                line-height: 1.6;
            }

            .action-group {
                display: flex;
                gap: 12px;
                justify-content: center;
                flex-wrap: wrap;
            }

            .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                padding: 12px 28px;
                border-radius: 50px;
                text-decoration: none;
                font-size: 15px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.25s ease;
            }

            .btn-home {
                color: #ffffff;
                background: var(--primary-color);
                border: 2px solid var(--primary-color);
            }

                .btn-home:hover {
                    background: var(--primary-hover);
                    border-color: var(--primary-hover);
                    transform: translateY(-2px);
                    box-shadow: 0 8px 20px rgba(43, 86, 52, 0.25);
                }

            .btn-refresh {
                color: var(--text-heading);
                background: #ffffff;
                border: 2px solid #e2e8f0;
            }

                .btn-refresh:hover {
                    background: #f8fafc;
                    border-color: #cbd5e1;
                    transform: translateY(-2px);
                }

            .btn svg {
                transition: transform 0.3s ease;
            }

            .btn-refresh:hover svg {
                transform: rotate(180deg);
            }

            @@keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(16px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes pulse {
                0%, 100% {
                    opacity: 1;
                }

                50% {
                    opacity: 0.4;
                }
            }

            @@media (max-width: 480px) {
                .card {
                    padding: 32px 20px;
                }

                .action-group {
                    flex-direction: column;
                }

                .btn {
                    width: 100%;
                }
            }
    </style>
</head>
<body>

    <div class="card">
        <!-- Logo -->
        <img src="~/assets/images/logos/cloudtree-logo.webp" alt="CloudTree Logo" class="brand-logo" />

        <!-- Warning Badge -->
        <div>
            <span class="status-badge">
                <span class="status-dot"></span>
                Connection Interrupted
            </span>
        </div>

        <!-- Heading -->
        <h1>Service Temporarily Unavailable</h1>

        <!-- Body Text -->
        <p>
            We are experiencing a temporary issue connecting to our core services.<br />
            Please wait a few moments and try reloading the page.
        </p>

        <!-- Action Buttons -->
        <div class="action-group">
            <button onclick="window.location.reload();" class="btn btn-refresh">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                    <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
                </svg>
                Try Again
            </button>

        </div>
    </div>

</body>
</html>