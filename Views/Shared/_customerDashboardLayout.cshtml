                        </li>
                    
            <!-- Notification Dropdown -->
            <li class="dropdown" id="notificationArea">
                  @await Component.InvokeAsync("Notification")
            </li>             
                    <li class="dropdown profile">
                        <a href="#" class="profile-btn nav-link">
                            <img src="@sessionImg" class="img-fluid" alt="user" />
                        </a>
                        <ul class="dropdown-menu p-2">
                            <li class="p-2">
                                <div class="profile-text">
                                    <h5 class="mb-0 text-ellipsis">@HttpContextAccessor.HttpContext?.Session.GetString("Contactperson")</h5>
                                    <div><span>@HttpContextAccessor.HttpContext?.Session.GetString("UserName")</span></div>
                                    @* <div class="small text-muted">
