                                                var memberId = HttpContextAccessor.HttpContext?.Session.GetString("MemberId");
                                            }
                                            @(string.IsNullOrEmpty(memberId) || memberId == "NA" ? string.Empty : memberId)
                                        </span>
                                    </div> *@
                                </div>

                            </li>

                            <li class="divider"></li>

                            <li class="nav-item">
                                @* <a asp-action="PortalProfile" asp-controller="CustomerManagement" class="nav-link"> *@
                                <a asp-route="CustomerProfile" class="nav-link">
                                    <span class="profile-menu-icon">
                                        <i class="fa-regular fa-user pe-2"></i> Profile
                                    </span>
                                    <i class="bi bi-chevron-right profile-menu-arrow"></i>
                                </a>
                            </li>

                            <li class="divider"></li>

                            <li class="nav-item">
                                @* <a asp-action="Logout" asp-controller="CustomerManagement" class="nav-link"> *@
                                <a asp-route="CustomerLogout" class="nav-link">
                                    <span class="profile-menu-icon">
                                        <i class="bi bi-box-arrow-right pe-2"></i> Logout
                                    </span>
                                    <i class="bi bi-chevron-right profile-menu-arrow"></i>
                                </a>
                            </li>
                        </ul>
                    </li>

                </ul>
            </div>

        </div>
</nav>
   
    <div>
        @RenderBody()
    </div>

    <!-- FOOTER START -->
