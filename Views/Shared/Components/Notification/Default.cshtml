<script type="text/javascript">
       $(document).on("click", "#clearallnotification", function (e) {
        e.preventDefault();
        

        if (!confirm("Are you sure you want to clear your Notification?")) {
            return;
        }

        $.ajax({
            url: '/CustomerManagement/ClearNotification',
            type: 'POST',
            success: function (response) {
                 $("#notificationArea").load("/CustomerManagement/ReloadNotification");
            },
            error: function () {
                alert("An error occurred while clearing your Notification.");
            }
        });
    });

</script>