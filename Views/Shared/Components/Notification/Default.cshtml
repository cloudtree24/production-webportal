    <ul class="dropdown-menu shadow" style="width: 350px; max-height: 450px; overflow-y: auto; padding: 0;">
        <li class="dropdown-header bg-light sticky-top border-bottom py-2">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-primary" style="font-weight: 600;">Notifications</h5>
                <a href="javascript:void(0);" class="small text-secondary text-decoration-none" id="clearallnotification">Mark all as read</a>
            </div>
        </li>

        @if (Model != null && Model.Any())
        {
            @foreach (var list in Model.OrderByDescending(e=>e.SendDate))
            {
                TimeSpan timeDifference = DateTime.Now.Subtract(list.SendDate);
                string timeAgo = "";

                if (timeDifference.TotalMinutes < 1) { timeAgo = "Just now"; }
                else if (timeDifference.TotalHours < 1) { timeAgo = $"{(int)timeDifference.TotalMinutes} min ago"; }
                else if (timeDifference.TotalDays < 1) { timeAgo = $"{(int)timeDifference.TotalHours} hr ago"; }
                else if (timeDifference.TotalDays < 10) { timeAgo = $"{(int)timeDifference.TotalDays} days ago"; }
                else { timeAgo = list.SendDate.ToString("MMM dd, yyyy"); }

                <li class="border-bottom">
                    <a href="#" class="d-flex align-items-start py-3 px-3 text-decoration-none"
                       style="white-space: normal; transition: background 0.2s; background: transparent;"
                       onmouseover="this.style.backgroundColor='#0d6efd'; this.querySelectorAll('.text-primary, .text-muted, i, p').forEach(el => el.style.setProperty('color', 'white', 'important'))"
                       onmouseout="this.style.backgroundColor='transparent'; this.querySelectorAll('.text-primary').forEach(el => el.style.setProperty('color', '#0d6efd', 'important')); this.querySelectorAll('.text-muted').forEach(el => el.style.setProperty('color', '#6c757d', 'important')); this.querySelector('p').style.color='black'; this.querySelector('i').style.color='#ffc107';">
                        <div class="flex-shrink-0 me-3">
                            <i class="bi bi-exclamation-circle text-warning fs-5"></i>
                        </div>
                        <div class="flex-grow-1 overflow-hidden">
                            <p class="mb-0 text-success small" style="line-height: 1.4;">@list.Message</p>
                            <small class="text-muted" style="font-size: 0.7rem;">@timeAgo</small>
                        </div>
                    </a>
                </li>
            }
        }
        else
        {
            <li class="p-4 text-center text-muted">
                <i class="bi bi-bell-slash d-block fs-3 mb-2"></i>
                <small>No new notifications</small>
            </li>
        }
    </ul>
}
else
{
    <a href="#" class="nav-link notification-icon" aria-label="Notifications">
        <i class="bi bi-bell"></i>
        <span class="badge bg-danger rounded-pill">0</span>
    </a>


}
