    <script type="module">
        // Modules are red by default, meaning they do not block the browser render
        import { createChat } from 'https://cdn.jsdelivr.net/npm/@@n8n/chat/dist/chat.bundle.es.js';

        const chat = createChat({
        webhookUrl: 'https://vmi3026238.contaboserver.net/webhook/e511a3f4-8887-4ae3-87f8-0b4c3ffb1afc/chat',
        initialMessages: ['Hi there! 👋 My name is Sree. How can I assist you today?']
        });

        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll('.openHcmChat').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                e.preventDefault();
                const toggleBtn = document.querySelector('#n8n-chat .chat-window-toggle');
                    if (toggleBtn) {
                        toggleBtn.click();
                    } else {
                        console.log('n8n chat toggle not found');
                    }
                });
            });
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const chatInvite = document.getElementById("chatInvite");
            // Show invite after 1 second
            setTimeout(() => {
                chatInvite.style.display = "block";
            }, 1000);
            // Function to hide invite and open chat
            function openChat() {
                chatInvite.style.display = "none";
                const timer = setInterval(() => {
                    const toggleBtn = document.querySelector("#n8n-chat .chat-window-toggle");
                    if (toggleBtn) {
                        toggleBtn.click();
                        clearInterval(timer);
                    }
                }, 300);
            }
            // Click on invite
            chatInvite.addEventListener("click", function () {
                openChat();
            });
            // Click on default n8n chat icon
