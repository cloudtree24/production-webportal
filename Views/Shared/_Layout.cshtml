    <script>
        function verifyCaptcha() {
            $("#captchaError").hide();
        }

        $(document).ready(function () {
            var form = $("#enquiryForm");

            $("input, textarea").on("input", function () {
                let id = $(this).attr("id");
                let val = $(this).val().trim();
                let errorSpan = $("#err_" + id);

                if (val === "") {
                    errorSpan.text("Required").show();
                } else if (id === "PhoneNumber") {
                    if (!/^[0-9]{10}$/.test(val)) {
                        errorSpan.text("Enter valid 10 digit mobile number").show();
                    } else {
                        errorSpan.hide();
                    }
                } else if (id === "EmailAddress") {
                    if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(val)) {
                        errorSpan.text("Enter valid email address").show();
                    } else {
                        errorSpan.hide();
                    }
                } else {
                    errorSpan.hide();
                }
            });

            form.on("submit", function (e) {
                e.preventDefault();
                $(".text-danger").hide();
                let name = $("#ProspectName").val().trim();
                let phone = $("#PhoneNumber").val().trim();
                let email = $("#EmailAddress").val().trim();
                let subject = $("#Subject").val().trim();
                let message = $("#Message").val().trim();
                let isValid = true;
                if (!name) { $("#err_ProspectName").text("Name is required").show(); isValid = false; }
                if (!phone) {
                    $("#err_PhoneNumber").text("Phone number is required").show();
                    isValid = false;
                } else if (!/^[0-9]{10}$/.test(phone)) {
                    $("#err_PhoneNumber").text("Enter valid 10 digit mobile number").show();
                    isValid = false;
                }         
                if (!email) {
                    $("#err_EmailAddress").text("Email is required").show();
                    isValid = false;
                } else if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
                    $("#err_EmailAddress").text("Enter valid email address").show();
                    isValid = false;
                }
                if (!subject) { $("#err_Subject").text("Subject is required").show(); isValid = false; }
                if (!message) { $("#err_Message").text("Message is required").show(); isValid = false; }
                var captchaResponse = grecaptcha.getResponse();
                if (captchaResponse.length === 0) {
                    $("#captchaError").text("Please verify captcha.").show();
                    isValid = false;
                }
                if (!isValid) return false;
                $("#btnSubmit").prop("disabled", true);
                $("#submitText").hide();
                $("#submitLoader").show();

                // ✅ AJAX Submit
                $.ajax({
                    url: '/Home/SendMessage',
                    type: 'POST',
                    data: form.serialize() + "&g-recaptcha-response=" + captchaResponse,
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({ icon: 'success', title: 'Success', text: response.message, confirmButtonColor: '#1e4c27' });
                            form[0].reset();
                            grecaptcha.reset();
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error', text: response.message });
                        }
                        resetButton();
                    },
                    error: function () {
                        Swal.fire({ icon: 'error', title: 'Error', text: 'Server error!' });
                        resetButton();
                    }
                });
            });

            function resetButton() {
                $("#btnSubmit").prop("disabled", false);
                $("#submitText").show();
                $("#submitLoader").hide();
            }
        });
    </script>
   
    <script>
        $(window).on("load", function () {
          var hash = window.location.hash;
          if (!hash) return;

          var $targetItem = $(hash);
          if (!$targetItem.length) return;

          var $button = $targetItem.find(".accordion-button");
          var $collapse = $targetItem.find(".accordion-collapse");

          if ($button.length && $collapse.length) {
            var $accordion = $targetItem.closest(".accordion");

            // close other open accordions inside same parent
            if ($accordion.length) {
              $accordion.find(".accordion-collapse.show").not($collapse).removeClass("show");

              $accordion.find(".accordion-button").not($button).each(function () {
                $(this).addClass("collapsed").attr("aria-expanded", "false");
              });
            }

            // open target accordion
            $collapse.addClass("show");
            $button.removeClass("collapsed").attr("aria-expanded", "true");

            // smooth scroll
            setTimeout(function () {
              $("html, body").animate({
                scrollTop: $targetItem.offset().top - 20
              }, 500);
            }, 150);
          }
        });
    </script>
    
