@{
    Layout = "_LayoutWithoutEnquiryForm";
}

<body>
    <div class="clearfix"></div>

    <div class="ct-inner_banner ct-gray__bg">
        <div class="container">
            <div class="row align-items-center g-1">
                <div class="col-md-5 wow animate__animated animate__fadeInLeft" data-wow-delay="0.1s" ">
                    <div class=" ct-inner__content mb-5">
                        <h2 class="ct-fs-90 fw-bold">The Next Big Things</h2>
                    </div>
                </div>
                <div class="col-md-7 wow animate__animated animate__fadeInRight" data-wow-delay="0.5s" ">
                    <img src="/assets/images/bg/lets-connect.png" class="img-fluid banner-img" alt="Career">
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <section>
            <div class="container">
                <div class="row text-center">
                    <div class="col-md-12 wow animate__ animate__fadeInRight  animated" data-wow-delay="0.5s">
                        <div class="ps-5">
                            <h2 class="ct-fs-48 fw-bold">All Your HR Needs in One Place</h2>
                            <p>
                                Our Smart HR Solution is designed to revolutionize the way organizations of all sizes manage their
                                human capital. Say goodbye to tedious manual processes and hello to Automated HCM software that will
                                unleash your company’s full potential.
                            </p>
                            <p><a href="#" class="ct-btn__darkTrans">Learn More</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="clearfix"></div>

    <section>
        <div class="container">
            <div class="ct-heading__section text-center mb-5">
                <h2 class="ct-fs-48">Features</h2>
                <div class="bar"></div>
            </div>
            <div class="row g-5 align-items-stretch">

                <!-- Card 1 -->
                <div class="col-md-4">
                    <div class="ct-serviceCard h-100">
                        <div class="d-flex flex-column h-100">

                            <!-- Job title -->
                            <h5 class="fw-bold mb-2">AI-Powered Automation</h5>
                            <p>
                                Harness the power of artificial intelligence to streamline your HR processes, from payroll to
                                performance management.
                            </p>

                        </div>
                    </div>
                </div>

                <!-- Card 2 -->
                <div class="col-md-4">
                    <div class="ct-serviceCard h-100">
                        <div class="d-flex flex-column h-100">

                            <!-- Job title -->
                            <h5 class="fw-bold mb-2">Comprehensive HR Management</h5>
                            <p>
                                Handle all aspects of human capital management with ease, including payroll, attendance tracking,
                                performance reviews, and more.
                            </p>

                        </div>
                    </div>
                </div>

                <!-- Card 3 -->
                <div class="col-md-4">
                    <div class="ct-serviceCard h-100">
                        <div class="d-flex flex-column h-100">

                            <!-- Job title -->
                            <h5 class="fw-bold mb-2">Great Value</h5>
                            <p>Big dreams, tight budget? No problem! Our tool is top-notch but is pocket friendly.</p>

                        </div>
                    </div>
                </div>


            </div>

        </div>
    </section>

    <section class="mt-0">
        <div class="container">
            <div class="bg-liht p-4 p-md-5 rounded-5 shadow-sm position-relative overflow-hidden"
                 style="background: linear-gradient(135deg, #064e3b, #10b981);">


                <div class="row align-items-center position-relative g-4">
                    <div class="col-lg-8">
                        <span class="text-uppercase small fw-bold text-white mb-2 d-inline-block">
                            Get
                            Started
                        </span>
                        <h2 class="ct-fs-48 fw-bold text-white mb-3">Start growing with HCM today</h2>
                        <p style="max-width: 680px; font-size: 1.1rem; line-height: 1.6;" class="text-white mb-0  opacity-75">
                            With tools to make every part of your process more human and a support team excited to help you, getting
                            started with a growth engine for your employees has never been easier.
                        </p>
                    </div>

                    <div class="col-lg-4 text-lg-end text-start">
                        <div class="d-inline-flex flex-column align-items-lg-center align-items-start gap-2">
                            <a href="#" class="btn btn-light btn-lg rounded-pill px-5 py-3 fw-bold ct-arrow__primary">
                                Book a Demo <span class="ct-arrow">→</span>
                            </a>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
</body>
