<!-- Team START -->
<section class="ct-team__section">
    <div class="container">
        <div class="ct-heading__section text-center mb-5">
            <h2 class="ct-fs-48">Meet our executive team</h2>
            <p class="mx-auto opacity-50">Meet our team of professionals to serve you</p>
        </div>
        <div class="row justify-content-center g-5">
            @await Component.InvokeAsync("OurTeam")
        </div>
    </div>
</section>
<script>
        document.querySelectorAll('.btn-drawer-open').forEach(btn => {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            this.closest('.card').classList.add('drawer-open');
        });
    });

    document.querySelectorAll('.btn-drawer-close').forEach(btn => {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            this.closest('.card').classList.remove('drawer-open');
        });
    });
</script>