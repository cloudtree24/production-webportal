    <!-- BLOG LIST START -->
    <div class="container ct-padding__120 ct-blog">
        <div class="d-flex align-items-center justify-content-between border-bottom mb-5 overflow-visible position-relative p-0">
            @{
                List<String> categories = new List<string>();
                categories = Model?.Blogs?.Where(e => e.Category != "Global").Select(x => x.Category).Distinct().ToList() ?? new List<string>();
            }
