                 <!-- "All" option to reset filter -->
                 <a href="javascript:void(0)" class="ct-category-pill filter-btn active" data-filter="all">
                    All Posts
                 </a>

                @foreach (var cat in categories)
                   {
                     if (!string.IsNullOrEmpty(cat))
                       {
                       <a href="javascript:void(0)" class="ct-category-pill filter-btn" data-filter="@cat">
                          @cat
                       </a>
                   }
                }
            </div>
            
