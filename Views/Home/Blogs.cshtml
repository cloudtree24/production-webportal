        </div>

        <div class="row">
			<div class="col-md-12">
                    <!-- BLOG LIST -->
                <div id="blogContainer">
					@{
						@if (Model != null && Model.Blogs!=null && Model.Blogs.Count() > 0)
						{
                            foreach (var item in Model.Blogs.OrderByDescending(e => e.PostedDate))
							{
								string imageurl = Common.GetUrlImageAndDocAddress() + ((!item.ImagePath.Contains("DefaultBlogBanner")) ? "assets/UploadImg/" + item.ImagePath
								: "assets/users/" + item.ImagePath);
                                <div class="card border-bottom p-3 border-0 rounded-0 blog-post-item" data-category="@item.Category">
                                    <div class="row align-items-center">
                                        <!-- IMAGE (4 columns) -->
                                        <div class="col-md-4">
                                            <div class="ct-blog__img">
                                                <img src="@imageurl" class="img-fluid rounded-4 w-100">
                                            </div>
                                        </div>

                                        <!-- CONTENT (8 columns) -->
                                        <div class="col-md-8">
                                            <div class="ct-blog__meta mb-2 d-flex gap-3 text-muted small">
                                                <span><i class="bi bi-calendar3 me-1"></i> @item.PostedDate.ToString("dd MMM yyyy")</span>
                                                <span><i class="bi bi-eye me-1"></i> @item.ViewsCount View</span>
                                            </div>
                                            <h3>
                                            <p class="fw-bold h4 mb-2" >
                                                 @item.PostTitle
                                                </p>
                                            </h3>
                                            @{
                                                var raw = item.Description ?? "";

                                                // Remove HTML tags
                                                var text = Regex.Replace(raw, "<.*?>", string.Empty);

                                                // Decode entities (&nbsp; etc.)
                                                text = WebUtility.HtmlDecode(text);

                                                // Take first 15 words
                                                var preview = string.Join(" ",
                                                text.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(15)
                                                ) + "...";
                                            }
                                            <div class="ct-blog__content mb-2 text-muted">
                                                @preview
                                            </div>

                                            @*<a href="/Blogs/@item.WebSlugName"
                                               class="ct-blog__readMore btn btn-outline-dark px-3 py-2">
                                                Read More
                                                <i class="bi bi-arrow-right"></i>
                                            </a>*@
                                            <a asp-route="BlogDetails"
                                               asp-route-slug="@item.WebSlugName"
                                               class="ct-blog__readMore btn btn-outline-dark px-3 py-2">
                                                Read More
                                                <i class="bi bi-arrow-right"></i>
                                            </a>

                                           

                                        </div>
                                    </div>
                                </div>
							}
						}
					}
                    </div>
			    
                <div class="ct-recentpost flex-column align-items-start ct-radius__md mb-5 mt-5">
                    <h2 class="ct-fs-24 fw-bold mb-4">Most Viewed Post</h2>

                    <div class="row">
                    @{
                        if (Model != null)
                        {
                            @foreach (var item in Model?.Blogs?.OrderByDescending(e => e.ViewsCount).Take(3) ?? new List<BlogViewModel>())
                            {
                                string reimageurl = Common.GetUrlImageAndDocAddress() + ((!item.ImagePath.Contains("DefaultBlogBanner")) ? "assets/UploadImg/" + item.ImagePath
                                : "assets/users/" + item.ImagePath);
                                <!-- Post item -->
                                <div class="col-md-4">
                                <div class="d-flex flex-column">

                                    <!-- Image -->
                                    <div class="ct-blog__img">
                                         <img src="@reimageurl" alt="Blog-Image" class="img-fluid rounded">
                                    </div>                                    
                                    @{
                                        var raw = item.Description ?? "";

                                        // Remove HTML tags
                                        var text = Regex.Replace(raw, "<.*?>", string.Empty);

                                        // Decode entities (&nbsp; etc.)
                                        text = WebUtility.HtmlDecode(text);

                                        // Take first 15 words
                                        var preview = string.Join(" ",
                                        text.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(10)
                                        ) + "...";
                                    }
                                    <!-- Content -->
                                    <div class="ct-blog__meta text-muted small mb-1">
                                                <i class="bi bi-calendar3"></i> @item.PostedDate.ToString("dd MMM yyyy")
                                        <span><i class="bi bi-eye"></i> @item.ViewsCount View</span>
                                    </div>
                                    <p class="mb-0">@preview</p>
                                </div>
                                </div>
                            }

                        }
                    }
                    </div>
                </div>

            </div>
