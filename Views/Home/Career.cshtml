<script type="text/javascript">
    window.onload = function () {
        var shouldOpenModal = '@ViewBag.OpenModal';

        if (shouldOpenModal === 'True') {
            var myModal = new bootstrap.Modal(document.getElementById('applyJobModal'));
            myModal.show();
        }
    };
</script>
<script type="text/javascript">
    function setJobId(jobId, jobTitle) {

        // Set Job Id in hidden field
        document.getElementById("JobId").value = jobId;

        // Set Job Title in readonly textbox
        document.getElementById("JobTitle").value = jobTitle;
        document.getElementById("selectJobtitle").value = jobTitle;
    }
</script>
<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function () {

        var type = '@TempData["ResultType"]';
        var message = '@TempData["ResultMessage"]';

        if (type) {

            // Set content
            document.getElementById("resultTitle").innerText =
                type === "Success" ? "Success" : "Error";

            document.getElementById("resultMessage").innerText = message;

            // Icon
            var iconHtml = type === "Success"
                ? '<i class="bi bi-check-circle-fill text-success" style="font-size:50px;"></i>'
                : '<i class="bi bi-x-circle-fill text-danger" style="font-size:50px;"></i>';

            document.getElementById("resultIcon").innerHTML = iconHtml;

            // Show modal
            var modal = new bootstrap.Modal(document.getElementById('resultModal'));
            modal.show();
        }
    });
</script>
<script type="text/javascript">

    $(function () {

    $.validator.unobtrusive.parse("#jobApplyForm");

    $("#jobApplyForm").on("submit", function (e) {

    $("#recaptchaError").text("");

    if (!$(this).valid()) {

    e.preventDefault();
    e.stopImmediatePropagation();

    return false;
    }

    var response = grecaptcha.getResponse();

    if (response.length === 0) {

    e.preventDefault();

    $("#recaptchaError").text("reCAPTCHA validation failed.");

    return false;
    }
    });

    });

</script>
<script type="text/javascript">

    $('#applyJobModal').on('hidden.bs.modal', function () {

    // Reset form fields
    $('#jobApplyForm')[0].reset();

    // Clear validation messages
    $('#jobApplyForm').find(".text-danger").html('');

    // Remove validation styles
    $('#jobApplyForm').find(".input-validation-error")
    .removeClass("input-validation-error");

    // Reset hidden fields manually
    $('#JobId').val('');
    $('#selectJobtitle').val('');

    // Reset reCAPTCHA
    if (typeof grecaptcha !== 'undefined') {
    grecaptcha.reset();
    }
    });

</script>

