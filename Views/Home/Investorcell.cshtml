
  @{
        Layout = "_LayoutWithoutEnquiryForm";
}

<body>

    <div class="ct-inner_banner ct-gray__bg">
        <div class="container">
            <div class="d-flex gap-2 align-items-center py-4 justify-content-between">
                <div class="ct-inner__content mb-4 w-50">
                    <h2 class="display-4 fw-bold mb-3">Investor Relations Cell</h2>
                    <p>Empowering our shareholders with transparent, timely,
                        and accurate financial information. Our Investor Relations
                        Cell is committed to maintaining open dialogue and fostering
                        long-term value for our global investment community. </p>
                </div>
                <img class="img-fluid banner-img" alt="Career" src="~/assets/images/banner/investor-cell-banner.png">
            </div>
        </div>
    </div>


    <section id="reports">
        <div class="container">
            <div class="ct-heading__section text-center mb-5">
                <h2 class="ct-fs-48">Investor Resources</h2>
                <div class="bar"></div>
            </div>
            <div class="row g-5 align-items-stretch">

                <!-- Card 1: Financial Reports -->
                <div class="col-md-4">
                    <div class="ct-serviceCard h-100">
                        <div class="d-flex flex-column h-100">
                            <h5 class="fw-bold mb-2">Financial Results</h5>
                            <p>Access our quarterly and annual financial statements, including balance sheets, income statements, and cash flow reports for the current and previous fiscal years.</p>
                            @* <div class="mt-auto pt-3">
                                <a href="#" class="text-decoration-none fw-bold">Download Reports &rarr;</a>
                            </div> *@
                        </div>
                    </div>
                </div>

                <!-- Card 2: Corporate Governance -->
                <div class="col-md-4">
                    <div class="ct-serviceCard h-100">
                        <div class="d-flex flex-column h-100">
                            <h5 class="fw-bold mb-2">Corporate Governance</h5>
                            <p>Learn about our board of directors, committee charters, and our commitment to ethical leadership and regulatory compliance across all operations.</p>
                            @* <div class="mt-auto pt-3">
                                <a href="#" class="text-decoration-none fw-bold">Read Policies &rarr;</a>
                            </div> *@
                        </div>
                    </div>
                </div>

                <!-- Card 3: Shareholder Services -->
                <div class="col-md-4">
                    <div class="ct-serviceCard h-100">
                        <div class="d-flex flex-column h-100">
                            <h5 class="fw-bold mb-2">Shareholder Information</h5>
                            <p>Get details on upcoming Annual General Meetings (AGM), dividend history, stock performance, and contact information for our transfer agents.</p>
                            @* <div class="mt-auto pt-3">
                                <a href="#" class="text-decoration-none fw-bold">View Schedules &rarr;</a>
                            </div> *@
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    @* <section class="mt-0">
        <div class="container">
            <div class="bg-liht p-4 p-md-5 rounded-5 shadow-sm position-relative overflow-hidden"
                 style="background: linear-gradient(135deg, #064e3b, #10b981);">


                <div class="row align-items-center position-relative g-4">
                    <div class="col-lg-8">
                        <span class="text-uppercase small fw-bold text-white mb-2 d-inline-block">
                            Get
                            Started
                        </span>
                        <h2 class="ct-fs-48 fw-bold text-white mb-3">Start growing with HCM today</h2>
                        <p style="font-size: 1.1rem; line-height: 1.6;" class="text-white mb-0  opacity-75">
                            With tools to make every part of your process more human and a support team excited to help you, getting
                            started with a growth engine for your employees has never been easier.
                        </p>
                    </div>

                    <div class="col-lg-4 text-lg-end text-start">
