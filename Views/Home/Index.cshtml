    <div class="ct-hrManagement__section ct-gray__bg section-padding">
        <div class="px-4 px-lg-0 container-lg">
            <div class="ct-heading__section text-center mb-5 wow animate__animated animate__fadeInUp"
                 data-wow-delay="0.1s">
                <h2 class="ct-fs-48 fw-bold">HR Management Software in India</h2>
                @* <div class="bar"></div> *@
                <p class="mx-auto ct-fs-24 fw-medium">Simplifying Workforce Management With Us.</p>
            </div>

            <ul class="nav nav-tabs border-0 wow animate__animated animate__fadeInUp" data-wow-delay="0.4s"
                id="myTab" role="tablist">
                @{
                    var hrmIcons = new string[]
                    {
                                "bi bi-currency-rupee", // Payroll/Money
                                "bi bi-person-fill-gear", // Core HR/Settings
                                "bi bi-person-rolodex", // Directory/Chatbot
                                "bi bi-file-earmark-person", // Recruitment/File
                                "bi bi-graph-up", // Performance/Growth
                                "bi bi-calendar-check", // Attendance/Schedule
                                "bi bi-shield-lock", // Security/Compliance
                                "bi bi-clock-history" // Time/Leave
                    };

                    // Setup for random selection
                    var random = new Random();
                    var isFirst = true; // Flag for setting the 'active' class
                }
                @foreach (var feature in Model?.featureList??new List<TblHomeFeatureMaster>())
                {
                    // Select a random icon from the array
                    var randomIndex = random.Next(hrmIcons.Length);
                    var selectedIconClass = hrmIcons[randomIndex];

                    // Create unique IDs
                    var targetId = $"#v-pills-{feature.Hmid}";
                    var tabId = $"{targetId}-tab";
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(isFirst ? "active" : "")"
                                id="@tabId"
                                data-bs-toggle="tab"
                                data-bs-target="@targetId"
                                type="button"
                                role="tab"
                                aria-controls="@targetId"
                                aria-selected="@(isFirst ? "true" : "false")">
                            @feature.Title
                        </button>
                    </li>

                    isFirst = false;
                }
            </ul>

            <div class="tab-content wow animate__animated animate__fadeInUp" data-wow-delay="0.7s"
                 id="myTabContent">
                @{
                    isFirst = true; // Reset flag for content panels
                }
                @foreach (var feature in Model.featureList)
                {
                    // Use the same unique ID structure
                    var targetId = $"v-pills-{feature.Hmid}";
                    var tabId = $"{targetId}-tab";

                    <div class="tab-pane fade @(isFirst ? "show active" : "")"
                         id="@targetId"
                         role="tabpanel"
                         aria-labelledby="@tabId"
                         tabindex="0">
                        <div class="card border-0">
                            <div class="card-body">
                                @Html.Raw(feature.Content)
                                @* <p><a href="#" class="ct-btn__darkTrans">View Now</a></p> *@
                            </div>
                        </div>
                    </div>

                    isFirst = false;
                }
               
            </div>
           
            <div class="mt-2 d-flex flex-wrap gap-3 justify-content-center">
                <!-- Primary CTA -->
                <a href="/hcm-solution/book-a-demo" class="ct-button__dark">
                    <i class="bi bi-calendar-check me-1"></i> Book a Demo
