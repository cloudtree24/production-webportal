<body>
 
    <div id="ct-main__banner" class="carousel slide" data-bs-ride="carousel">
        <div class="ct-banner__section_bg"></div>

        @if (Model?.bannerList != null && Model.bannerList.Any())
        {
            <div class="carousel-indicators">
                @for (int i = 0; i < Model.bannerList.Where(e=>e.PageFor=="Home").Count(); i++)
                {
                    <button type="button"
                                data-bs-target="#ct-main__banner"
                            data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")"
                            aria-label="Slide @(i + 1)">
                    </button>
                }
            </div>
        }

        <div class="carousel-inner h-100">
            @{
                var index = 0;
            }
            @if (Model?.bannerList != null)
            {
                foreach (var item in Model.bannerList.Where(e => e.PageFor == "Home").ToList())
                {
                    var imagePath = item.ImageName;
                    <div class="carousel-item @(index == 0 ? "active" : "")">
                        <div class="ct-banner__section">
                            @if (!String.IsNullOrEmpty(item.TextContent))
                            {
                                <div class="ct-banner__text text-white">
                                    @Html.Raw(item.TextContent)
                                </div>
                            }
                            <img src="@imagePath" class="img-fluid" alt="HCM banner @(index + 1)" />
                        </div>
                    </div>
                    index++;
                }
            }

        </div>
