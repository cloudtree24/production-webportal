@{
    Layout = "_LayoutWithoutEnquiryForm";
}

<body>

    @* <div class="ct-inner_banner ct-gray__bg">
        <div class="container">
            <div class="d-flex gap-2 align-items-center py-4 justify-content-between">
                <div class="ct-inner__content mb-4 w-50">
                    <h2 class="display-4 fw-bold mb-3">Security &amp; Trust</h2>
                    <p>Your data is protected with enterprise-grade security, privacy, and compliance standards.</p>
                </div>
                <img class="img-fluid banner-img" alt="Career" src="~/assets/images/banner/security-trust-banner.png">
            </div>
        </div>
    </div> *@

    <div class="container">
        <section>
            <div class="row">
                <div class="col-lg-12 text-center">
                    <div class="ct-heading__section text-center mb-5">
                        <h2 class="ct-fs-48 fw-bold">
                            Architected for Absolute Trust.
                        </h2>
                        <p class="mx-auto opacity-50">
                            Enterprise workforce security isn't a feature—it's the core. We safeguard your human resource capital
                            and
                            data streams with multi-layered digital defenses.
                        </p>
                        <div class="d-flex justify-content-center mb-3"><a href="https://hcmportal.anantatek.com/Dashboard/Index" class="btn btn-outline-success btn-lg px-5 rounded-pill">View Security Controls</a></div>
                        <div class="row g-4 mb-5 text-center">

                            <div class="col-md-3 col-6">
                                <div class="p-4 bg-white rounded-4 shadow-sm h-100">
                                    <h3 class="fw-bold text-success mb-1">99.99%</h3>
                                    <p class="mb-0">Guaranteed Platform Uptime</p>
                                </div>
                            </div>

                            <div class="col-md-3 col-6">
                                <div class="p-4 bg-white rounded-4 shadow-sm h-100">
                                    <h3 class="fw-bold text-primary mb-1">AES-256</h3>
                                    <p class="mb-0">Enterprise Data Encryption</p>
                                </div>
                            </div>

                            <div class="col-md-3 col-6">
                                <div class="p-4 bg-white rounded-4 shadow-sm h-100">
                                    <h3 class="fw-bold text-danger mb-1">24/7</h3>
                                    <p class="mb-0">Real-Time Threat Monitoring</p>
                                </div>
                            </div>

                            <div class="col-md-3 col-6">
                                <div class="p-4 bg-white rounded-4 shadow-sm h-100">
                                    <h3 class="fw-bold text-warning mb-1">ISO</h3>
                                    <p class="mb-0">Global Compliance Standards</p>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>

            </div>
        </section>
        <section class="mt-0">
            <div class="ct-heading__section text-center mb-5">
                <span class="text-success small fw-bold text-uppercase tracking-wider">System Layering</span>
                <h2 class="ct-fs-48 fw-bold">Security Controls</h2>
            </div>

            <div class="row g-0 tech-grid border rounded-4 overflow-hidden bg-white">
                <div class="col-lg-4 tech-grid-cell p-5 border-end border-bottom">
                    <div class="tech-icon mb-4 text-success"><i class="bi bi-shield-lock"></i></div>
                    <h4 class="fw-bold text-dark mb-3">Isolation Layer</h4>
                    <p class="text-muted small mb-0">
                        Every database layer runs on an isolated operational architecture.
                        Cryptographic TLS tunnels secure all transit patterns dynamically across runtime nodes.
                    </p>
                </div>
                <div class="col-lg-4 tech-grid-cell p-5 border-end border-bottom">
                    <div class="tech-icon mb-4 text-success"><i class="bi bi-person-badge"></i></div>
                    <h4 class="fw-bold text-dark mb-3">Identity Layer</h4>
                    <p class="text-muted small mb-0">
                        Role-Based Access Controls (RBAC) keep department datasets highly
                        segmented. Identity federation pairs directly with Microsoft Azure AD or Okta.
                    </p>
                </div>
                <div class="col-lg-4 tech-grid-cell p-5 border-bottom">
                    <div class="tech-icon mb-4 text-success"><i class="bi bi-fingerprint"></i></div>
                    <h4 class="fw-bold text-dark mb-3">Access Layer</h4>
                    <p class="text-muted small mb-0">
                        Multi-factor security enforcement blocks unverified access. Hardware
                        attestation variables validate employee access based on corporate IP boundaries.
                    </p>
                </div>
                <div class="col-lg-4 tech-grid-cell p-5 border-end">
                    <div class="tech-icon mb-4 text-success"><i class="bi bi-terminal"></i></div>
                    <h4 class="fw-bold text-dark mb-3">Audit Logs</h4>
                    <p class="text-muted small mb-0">
                        Immutable records capture system updates, data migrations, configuration
                        resets, and payroll extractions instantly for operational traceability.
                    </p>
                </div>
                <div class="col-lg-4 tech-grid-cell p-5 border-end">
                    <div class="tech-icon mb-4 text-success"><i class="bi bi-cloud-arrow-up"></i></div>
                    <h4 class="fw-bold text-dark mb-3">Resilience Grid</h4>
                    <p class="text-muted small mb-0">
                        Continuous real-time database snapshots back up your parameters safely
                        across secure geological environments with automatic active failover targets.
                    </p>
                </div>
                <div class="col-lg-4 tech-grid-cell p-5 bg-light-subtle d-flex flex-column justify-content-center">
                    <h5 class="fw-bold text-dark mb-2">Need a custom security structure?</h5>
                    <p class="text-muted small mb-3">
                        We deploy dedicated host instances and private keys for enterprise
                        partners.
                    </p>
                    <a href="#" class="text-dark fw-bold small text-decoration-none d-flex align-items-center gap-1">
                        Contact
                        Devops <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </section>
    </div>

</body>
