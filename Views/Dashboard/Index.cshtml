            <p class="mx-auto opacity-50">Revolutionize Employee Management with AI-enabled HR Operations</p>
        </div>

        <div class="hcm-tabs mb-5 mt-5">
            <div class="container">
                @{
                    var hrmIcons = new string[]
                    {
                        "bi bi-graph-up fs-2", // Unified HR
                        "bi bi-currency-rupee fs-2", // Payroll/Money
                        "bi bi-person-fill-gear fs-2", // Core HR/Settings
                        "bi bi-person-rolodex fs-2", // Directory/Chatbot
                        "bi bi-file-earmark-person fs-2", // Recruitment/File
                        "bi bi-graph-up fs-2", // Performance/Growth
                        "bi bi-calendar-check fs-2", // Attendance/Schedule
                        "bi bi-shield-lock fs-2", // Security/Compliance
                        "bi bi-clock-history fs-2" // Time/Leave
                    };

                    // Setup for random selection
                    var random = new Random();
                    var isFirst = true; // Flag for setting the 'active' class
                }

                <div class="row">

                    <div class="col-md-12">
                        <div class="nav nav-pills h-100 gap-3" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                            @foreach (var feature in Model.featureList)
                            {
                                // Select a random icon from the array
                                var randomIndex = random.Next(hrmIcons.Length);
                                var selectedIconClass = hrmIcons[randomIndex];

                                // Create unique IDs
                                var targetId = $"v-pills-{feature.Hmid}";
                                var tabId = $"{targetId}-tab";

                                <button class="nav-link @(isFirst ? "active" : "")"
                                        id="@tabId"
                                        data-bs-toggle="pill"
                                        data-bs-target="#@targetId"
                                        type="button"
                                        role="tab"
                                        aria-controls="@targetId"
                                        aria-selected="@(isFirst ? "true" : "false")">

                                    @* Add the randomly selected icon here *@
                                    <i class="@selectedIconClass"></i> @feature.Title
                                </button>

                                isFirst = false;
                            }
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="tab-content" id="v-pills-tabContent">
                            @{
                                isFirst = true; // Reset flag for content panels
                            }
                            @foreach (var feature in Model.featureList)
                            {
                                // Use the same unique ID structure
                                var targetId = $"v-pills-{feature.Hmid}";
                                var tabId = $"{targetId}-tab";

                                <div class="tab-pane fade @(isFirst ? "show active" : "")"
                                     id="@targetId"
                                     role="tabpanel"
                                     aria-labelledby="@tabId">

                                        <div class="content">
                                            <h3>@feature.Title</h3>
                                            @* Use @Html.Raw() to render content that includes HTML like <br> or <h3> *@
                                            @Html.Raw(feature.Content)
                                        </div>
                                </div>

                                isFirst = false;
                            }

                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</section>

