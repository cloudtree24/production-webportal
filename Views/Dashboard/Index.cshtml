<div id="slider" class="carousel slide hero-centered-layout" data-bs-ride="carousel">

    @if (Model?.bannerList != null && Model.bannerList.Where(e => e.PageFor == "Product").ToList().Any())
    {
            <div class="carousel-indicators modern-pills justify-content-center ms-5">
            @for (int i = 0; i < Model.bannerList.Where(e => e.PageFor == "Product").ToList().Count(); i++)
            {
                <button type="button"
                        data-bs-target="#slider"
                        data-bs-slide-to="@i"
                        class="@(i == 0 ? "active" : "")"
                        aria-label="Slide @(i + 1)">
                </button>
            }
        </div>
    }
    <div class="carousel-inner">
        @{
            var index = 0;
        }
        @if (Model.bannerList != null)
        {
            foreach (var item in Model.bannerList.Where(e => e.PageFor == "Product").ToList())
            {
                var imagePath = item.ImageName;
                <div class="carousel-item @(index == 0 ? "active" : "")">
                    <div class="hero-item-wrapper">
                         <img src="@imagePath" class="hero-img" alt="HCM banner @(index + 1)" />
                         <div class="hero-overlay-content">
                             <div class="container">
                                 <div class="row">
                                     <div class="col-md-6">
                                            <div class="hero-text-box animate-up text-white ct-fs-30 fw-bold">
                                                @Html.Raw(item.TextContent)
                                                @* <a href="#" class="btn btn-green-gradient px-5 py-2 rounded-pill shadow">
                                                    Book a Demo
                                                </a> *@
                                            </div>
                                    </div>
                                </div>
                             </div>
                         </div>
                    </div>
                </div>
                index++;
            }
        }
    </div>
    @* <button class="carousel-control-prev" type="button" data-bs-target="#slider" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#slider" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
