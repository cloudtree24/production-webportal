        <div class="container">
                <div class="productPlan">

        <!-- Plan Toggle -->
        <div class="d-flex justify-content-center align-items-center mb-4">
            <div class="plan-toggle-group" role="group" aria-label="Plan selection">
                @{
                    var index = 0;
                }
                @if (Model.Plans != null)
                {
                    foreach (var plan in Model.Plans)
                    {
                        <input type="radio"
                               class="btn-check"
                               name="selectedPlan"
                               id="plan-@plan.PlanId"
                               value="@plan.PlanId"
                               autocomplete="off"
                               @(index == 0 ? "checked" : "")>
                        <label class="plan-btn" for="plan-@plan.PlanId">
                            @plan.PlanName
                        </label>
                        index++;
                    }
                }
            </div>
        </div>

        <!-- Heading + Intro -->
        <div class="d-flex flex-column align-items-center text-center mb-4">
            <h3>Choose your Best plan</h3>
            <p class="mb-0">
                Find the perfect plan that fits your needs. We have flexible options designed for
                individuals,<br>
                teams, and businesses. Compare and pick what works best for you.
            </p>
        </div>

        <!-- Feature Highlights -->
        <div class="row justify-content-center mb-5">
            <div class="col-lg-3">
                <div class="media d-flex align-items-center py-2 p-sm-2">
                    <div class="icon-box mb-0 bg-primary-soft rounded-circle d-block me-3">
                        <i class="bi bi-credit-card text-primary"></i>
                    </div>
                    <div class="media-body fw-medium h6 mb-0">
                        Flexible payments
                    </div>
                </div>
            </div>
            <div class="col-lg-3">
                <div class="media d-flex align-items-center py-2 p-sm-2">
                    <div class="icon-box mb-0 bg-success-soft rounded-circle d-block me-3">
                        <i class="bi bi-calendar-check text-success"></i>
                    </div>
                    <div class="media-body fw-medium h6 mb-0">
                        Get 30 day free trial
                    </div>
                </div>
            </div>
            <div class="col-lg-3">
                <div class="media d-flex align-items-center py-2 p-sm-2">
                    <div class="icon-box mb-0 bg-danger-soft rounded-circle d-block me-3">
                        <i class="bi bi-calendar-x text-danger"></i>
                    </div>
                    <div class="media-body fw-medium h6 mb-0">
                        Cancel anytime
                    </div>
                </div>
            </div>
        </div>

        <!-- Plan Bodies -->
        @foreach (var plan in Model.Plans ?? Enumerable.Empty<PlanMaster>())
        {
            <div class="productPlan_body" id="plan-@plan.PlanId-body"
                 style="@(plan == Model.Plans?.First() ? "" : "display:none;")">
                <div class="row justify-content-center">
                    @if(Model.SubscriptionDetails!=null)
                    {
                        @foreach (var detail in Model.SubscriptionDetails.Where(d => d.Bid == plan.PlanId))
                    {
                        <div class="col-lg-4 col-md-6 col-sm-12">
                            <div class="card bg-light mb-3 rounded-custom">
                                <div class="card-body">
                                    <p class="mb-1">@detail.SubscriptionName</p>
                                    <div class="d-flex align-items-center mb-2">
                                        <h4>₹@detail.Amount</h4>
                                        <span class="d-inline-flex ms-1">/ @plan.PlanName</span>
                                    </div>
                                    <p class="mb-3">Feature for up to @detail.MaximumMemberCount users</p>
                                   @*  <a href="login.html" class="btn btn-primary btn-lg w-100 mb-3">Subscribe Now</a> *@
                                    <a asp-action="CheckoutDetails" asp-controller="Order" class="btn btn-primary btn-lg w-100 mb-3">Subscribe Now</a>
                                    <span class="d-block mb-1">Features</span>
                                    <p class="mb-2">@detail.Details</p>
                                </div>
                            </div>
                        </div>
                    }
                    }
                </div>
            </div>
            }
      </div>
        </div>


