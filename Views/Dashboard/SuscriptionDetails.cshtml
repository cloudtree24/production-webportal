   <script>
document.addEventListener("DOMContentLoaded", function () {
    const radios = document.querySelectorAll('input[name="selectedPlan"]');

    radios.forEach((radio) => {
        
        radio.addEventListener("change", function () {
            document.querySelectorAll('.productPlan_body').forEach(body => {
                body.style.display = 'none';
            });
             
            const target = document.getElementById('plan-' + this.value + '-body');
            if (target) target.style.display = 'block';
        });
    });

    // ✅ Show the first plan-body by default
    if (radios.length > 0) {
        const target = document.getElementById('plan-' + radios[0].value + '-body');
        if (target) target.style.display = 'block';
    }
});


</script>


