@{
    Layout = "_customerDashboardLayout";
    <script src="~/assets/js/jquery.min.js"></script>
    <script src="~/assets/js/vanilla-toast.min.js"></script>

}


    <!-- Breadcrumb -->
    <section class="breadcumnd__banner">
      <!--Container-->
      <div class="container">
        <div class="d-flex justify-content-start gap-4">
          <h2 class="bread__title">
            Downgrade Plan
          </h2>
          <ul class="breadcumnd__link">
            <li>
            <a asp-controller="CustomerManagement" asp-action="PortalDashboard">Dashboard</a>
            </li>
            <li><i class="bi bi-chevron-right"></i></li>
            <li class="active">
              <a href="javascript:void(0)">Downgrade Plan</a>
            </li>
          </ul>
        </div>
      </div>
      <!--Container-->
    </section>

    <div class="section_gap_large">

        <div class="container">
<div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="card box">

                            <div class="card-body"> 

                                <div class="p-2">
                                    <div class="text-center">

                                        <div class="avatar-md mx-auto">
                                            <div class="avatar-title rounded-circle bg-light">
                                                <i class="bi bi-exclamation-triangle text-danger"></i>
                                            </div>
                                        </div>
                                        <div class="p-2">
                                            <h4>Are you sure to <span class="fw-semibold">Downgrade</span>, your plan ?</h4>
                                            <p>Downgrading to the Basic plan will limit your access to premium features. This change will take effect on your next billing cycle.</p>
                                            <div class="mt-4">
                                        <a asp-action="DowngradeSubscriptionreason" class="btn btn-primary w-md">Procced To Downgrade</a>
                                        <a asp-action="MySubscriptionDetails" class="btn btn-outline-primary w-md">Cancel</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
        </div>
      </div>

<div class="main">
    <div class="green-line"></div>
</div>