@section Scripts {

	<script>
		function loadUpgradeOptions() {
			$("#modalBodyContent").html('<div class="text-center p-5"><div class="spinner-border text-primary"></div></div>');
			$("#upgradeModal").modal('show');

			$.get("@Url.Action("GetUpgradeOptionsPartial", "Subscription")", function (data) {
				$("#modalBodyContent").html(data);

				// Use event delegation to handle the toggle for dynamically loaded elements

			const initialBody = document.querySelector(
                    '#modalBodyContent .productPlan_body:not([style*="display:none"])'
                );
            if (initialBody) {
                initialBody.style.display = 'block';
                // Force reflow
                void initialBody.offsetWidth;
                // Add active class
                initialBody.classList.add('plan-active');
            }
				
		   $(document).off('change', 'input[name="modalSelectedPlan"]')
					.on('change', 'input[name="modalSelectedPlan"]', function () {
					const target = $('#m-body-' + $(this).val());
					const planBodies = $('.productPlan_body');

					// HIDE CURRENT PLAN //
					planBodies.each(function () {
						const body = $(this);
						if (body.hasClass('plan-active')) {
							body.removeClass('plan-active');
							body.addClass('plan-hide');
							setTimeout(function () {
								body.css('display', 'none');
								body.removeClass('plan-hide');
							}, 350);
						} else {
							body.css('display', 'none');
						}
					});
					// SHOW SELECTED PLAN //
					setTimeout(function () {
						if (target.length) {
							target.css('display', 'block');
							// Force reflow
							target[0].offsetWidth;
							// Add active animation
							target.addClass('plan-active');
						}
					}, 360);

				});

			});
		}
		function calc(val, uid, usersPerPack, costPerPack) {
			
			// UI elements
			const pCountElem = document.getElementById('pCount_' + uid);
			const uCountElem = document.getElementById('uCount_' + uid);
			const pCostElem  = document.getElementById('pCost_' + uid);
			const taxAmtElem = document.getElementById('taxAmt_' + uid); // Tax UI

			// Hidden inputs
			const hPackElem  = document.getElementById('hPack_' + uid);
			const hUsersElem = document.getElementById('hUsers_' + uid);
			const hCostElem  = document.getElementById('hCost_' + uid);
			const hTaxElem   = document.getElementById('hTax_' + uid);   // Tax Hidden Input

			// Get Tax Percentage from ViewBag
			const taxPercent = parseFloat('@ViewBag.TaxPercentage');

			let currentPacks = parseInt(pCountElem.innerText);
			let newPacks = Math.max(1, currentPacks + val);

			// Calculations
			let totalBaseCost = newPacks * costPerPack;
			let totalUsers    = newPacks * usersPerPack;
			let taxAmount     = (totalBaseCost * taxPercent) / 100;

			// 🔹 Update UI
			pCountElem.innerText = newPacks;
			uCountElem.innerText = totalUsers;
			pCostElem.innerText  = totalBaseCost.toFixed(2);
			taxAmtElem.innerText = taxAmount.toFixed(2); // Display tax with 2 decimals

			// 🔥 Update hidden inputs
			hPackElem.value  = newPacks;
			hUsersElem.value = totalUsers;
			hCostElem.value  = totalBaseCost.toFixed(2);
			hTaxElem.value   = taxAmount.toFixed(2); // Send tax amount to controller
		}


