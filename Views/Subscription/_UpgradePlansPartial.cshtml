 @using HCMPortal.ViewModel
@model HCMPortal.ViewModel.SubscriptionPageViewModel
@{
    var trialPlanDetails = ViewBag.TrialPlan as SubscriptionDetailsViewModel ?? new SubscriptionDetailsViewModel();
}

<div class="productPlan m-0">
    <div class="d-flex justify-content-center align-items-center mb-4">
        @if (Model.Plans != null && Model.Plans.Count() > 1)
        {
            <div class="plan-toggle-group" role="group">
                @{
                    var idx = 0;
                }
                @foreach (var plan in Model.Plans)
                {
                    <input type="radio" class="btn-check plan-toggle-radio" name="modalSelectedPlan" id="m-plan-@plan.PlanId" value="@plan.PlanId" @(idx == 0 ? "checked" : "")>
                    <label class="plan-btn" for="m-plan-@plan.PlanId">@plan.PlanName</label>
                    idx++;
                }
            </div>
        }
    </div>

    @foreach (var plan in Model.Plans ?? Enumerable.Empty<PlanMaster>())
    {
        <div class="productPlan_body modal-plan-body" id="m-body-@plan.PlanId" style="@(plan == Model.Plans?.First() ? "" : "display:none;")">
            <div class="row justify-content-center">
                @foreach (var detail in Model.SubscriptionDetails.Where(d => d.Bid == plan.PlanId && d.Amount != 0))
                {
                    <div class="col-lg-4 col-md-6 col-sm-12">
                        <div class="card bg-light mb-3 rounded-custom h-100 @(detail.IsRecommended == 1 ? "active" : "")">
                            <div class="card-body card-inner-canvas d-flex flex-column p-4 h-100">
                                
                                <div>
                                    <div class="d-flex justify-content-between flex-column mb-2 card-header h-100">
                                        @if (detail.IsRecommended == 1)
                                        {
                                            <span class="badge bg-pink badge-top">Recommended</span>
                                        }
                                        <div>
                                            <h4 class="plan-name mb-0">@detail.SubscriptionName</h4>
                                            <div class="pricing-amount mb-2">
                                                <span class="currency">₹</span>
                                                <span class="price-value">@detail.Amount</span>
                                                <span class="duration">/ @plan.PlanName</span>
                                            </div>
                                            <p class="text-muted small mb-1 text-success">Up to @detail.MaximumMemberCount users</p>
                                        </div>
                                        <a asp-controller="Order" asp-action="CheckoutDetails" asp-route-sid="@detail.Sid"
                                            asp-route-pid="@plan.PlanId" asp-route-isupgradeFromTrial="true"
                                            class="btn btn-primary w-100">Upgrade Now</a>
                                    </div>
                                </div>

                                <div class="d-flex flex-column justify-content-between mb-2">
                                    <span class="d-block mb-1">Features</span>
                                    <p class="mb-2">Includes in this @detail.SubscriptionName </p>
                                    <ul class="p-0 m-0">
                                        @{
                                            List<string> featureList =
                                                                detail.Details?
                                                                .Split('.')
                                                                .Where(e => !String.IsNullOrEmpty(e))
                                                                .ToList()
                                                                ?? new List<string>();
                                            foreach (var item in featureList)
                                            {
                                                <li class="d-flex align-items-center mb-2">
                                                    <span class="pricing-check me-2">
                                                        <i class="bi bi-patch-check-fill text-primary"></i>
                                                    </span>@item
                                                </li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>