@model HCMPortal.Models.RazorpayCheckoutViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Razorpay Checkout</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div id="loader" style="position: fixed; inset: 0; background: rgba(255,255,255,0.9);
         display:flex; flex-direction:column; justify-content:center; align-items:center; gap:20px;">
        <img src="@Url.Content("~/assets/images/logos/cloudtree-logo.webp")" style="width:120px;" />
        <div class="spinner-border" style="width:4rem;height:4rem;"></div>
        <h4>Redirecting to payment...</h4>
    </div>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
        var isSubscription = @Model.IsSubscription.ToString().ToLower();
        var isAddon = @Model.IsAddonPayment.ToString().ToLower();
        var isUpgrade = @Model.isUpgrade.ToString().ToLower();
        var options = {
            key: "@Model.Key",
            name: "CLOUDTREE AI INDIA PRIVATE LIMITED",
            description: "Subscription Payment",
            image: "@Url.Content("~/assets/images/logo.png")",
            description: (isSubscription || isUpgrade) ? "Subscription Upgrade" : "Payment",
            prefill: {
                name: "@Model.CustomerName",
                email: "@Model.Email",
                contact: "@Model.Phone"
            },
            theme: { color: "#145A32" },
            handler: function (response) {
                if (isAddon) {
                    window.location.href = "/Subscription/AddonPaymentSuccess"
                        + "?razorpay_payment_id=" + response.razorpay_payment_id
                        + "&orderId=" + response.razorpay_order_id
                        + "&razorpay_signature=" + response.razorpay_signature;
                }
                else if (isUpgrade) {
                    window.location.href = "/Subscription/PaymentSuccess"
                     + "?razorpay_payment_id=" + response.razorpay_payment_id
                        + "&razorpay_subscription_id=" + response.razorpay_subscription_id
                        + "&razorpay_signature=" + response.razorpay_signature;
                }
                else if (isSubscription) {
                    window.location.href = "/Subscription/SubscriptionSuccess"
                        + "?razorpay_payment_id=" + response.razorpay_payment_id
                        + "&razorpay_subscription_id=" + response.razorpay_subscription_id
                        + "&razorpay_signature=" + response.razorpay_signature;
                }
            },
            modal: {
                ondismiss: function () {
                            var paymentType;

        if (isSubscription || isUpgrade)
            paymentType = "Normal";
        else if (isAddon)
            paymentType = "Normal";
        else
            paymentType = "Normal";

                    window.location.href = "/Subscription/PaymentFailure?status=cancelled&paymentType=" + paymentType;
                }
            }
        };
        if (isSubscription || isUpgrade) {
            options.subscription_id = "@Model.OrderId";
        } else {
            options.order_id = "@Model.OrderId";
            options.amount = "@(Model.Amount * 100)";
            options.currency = "INR";
        }
        var rzp = new Razorpay(options);
        rzp.on('payment.failed', function (response) {
                   var paymentType;

        if (isSubscription || isUpgrade)
            paymentType = "Subscription";
        else if (isAddon)
            paymentType = "Normal";
        else
            paymentType = "Normal";

            window.location.href = "/Subscription/PaymentFailure"
                + "?status=failed"
                + "&paymentType=" + paymentType
                + "&errorDescription=" + encodeURIComponent(response.error.description);
        });
        rzp.open();
    </script>
</body>
</html>