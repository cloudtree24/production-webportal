@using HCMPortal.ViewModel
@model HCMPortal.ViewModel.SubscriptionPageViewModel
@inject IHttpContextAccessor httpContextAccessor

@{
    ViewData["Title"] = "Subscription Details | HRMS - TheCloudTree ";
    Layout = "_LayoutWithoutEnquiryForm";
}

@{
    // Cast the object from ViewBag back to its specific type
    SubscriptionDetailsViewModel trialPlanDetails = ViewBag.TrialPlan ?? new SubscriptionDetailsViewModel();
}

<body>

    <section>
        <div class="container">
            <div class="productPlan">
                <div class="text-center mb-4">
                    <h2 class="pricing-title mt-1 mb-3">Choose your Best plan</h2>

                    <p class="pricing-desc text-muted mx-auto mb-3">
                        Find the perfect plan that fits your needs.We have flexible options designed for individuals,
                        teams, and businesses. Compare and pick what works best for you.
                    </p>

                    <div class="d-flex justify-content-between align-items-center w-75 m-auto integrated-trust-banner">

                        <div class="trust-item">
                            <div class="trust-icon blue">
                                <i class="bi bi-credit-card text-primary"></i>
                            </div>
                            Flexible payments
                        </div>

                        <div class="trust-divider"></div>

                        <div class="trust-item">
                            <div class="trust-icon green">
                                <i class="bi bi-calendar-check text-success"></i>
                            </div>
                            15-day free trial
                        </div>

                        <div class="trust-divider"></div>

                        <div class="trust-item">
                            <div class="trust-icon red">
                                <i class="bi bi-calendar-x text-danger"></i>
                            </div>
                            Cancel anytime
                        </div>

                    </div>

                    <!-- PLAN SWITCH -->
                    <div class="d-flex justify-content-center align-items-center mt-5">

                        @if (Model.Plans != null && Model.Plans.Count() > 1)
                        {
                            <div class="plan-toggle-group" role="group" aria-label="Plan selection">

                                @{
                                    var index = 0;
                                }

                                @foreach (var plan in Model.Plans)
                                {
                                    <input type="radio"
                                           class="btn-check plan-toggle-radio"
                                           name="selectedPlan"
                                           id="plan-@plan.PlanId"
                                           value="@plan.PlanId"
                                           autocomplete="off"
                                           @(index == 0 ? "checked" : "")>

                                    <label class="plan-btn" for="plan-@plan.PlanId">
                                        @plan.PlanName
                                    </label>

                                    index++;
                                }

                            </div>
                        }

                    </div>

                </div>

                <!-- PLAN BODY -->
                @foreach (var plan in Model.Plans ?? Enumerable.Empty<PlanMaster>())
                {
                    var index = 0;
                    <div class="productPlan_body"
                         id="plan-@plan.PlanId-body"
                         style="@(plan == Model.Plans?.First() ? "display:block;" : "display:none;")">
                        <div class="row justify-content-center">
                            @if (Model.SubscriptionDetails != null)
                            {
                                @foreach (var detail in Model.SubscriptionDetails.Where(d => d.Bid == plan.PlanId))
                                {
                                    @if (detail.Amount != 0)                                    {
                                        @if (ViewBag.SubscriptionWarning != null && index == 0)
                                        {
                                            <div class="alert alert-warning mb-3" role="alert">
                                                <p>@ViewBag.SubscriptionWarning</p>
                                            </div>
                                        }
                                        @if (index == 0 && trialPlanDetails.Sbfid != 0)
                                        {
                                            <div class="col-lg-4 col-md-6 col-sm-12">
                                                <div class="card bg-light mb-3 rounded-custom h-100">
                                                    <div class="card-body card-inner-canvas d-flex flex-column p-4 h-100">
                                                        <div class="d-flex flex-column justify-content-between mb-2 card-header">
                                                            <h4 class="plan-name mb-0">
                                                                @trialPlanDetails.SubscriptionName
                                                            </h4>                                                           
                                                            <div class="pricing-amount mb-2">
                                                                <span class="currency">₹</span>
                                                                <span class="price-value">0</span>
                                                            </div>
                                                            <p class="text-muted small mb-2">
                                                                Feature for up to @trialPlanDetails.MaximumMemberCount users
                                                            </p>
                                                            <div class="mt-2 pt-2">
                                                                <a asp-controller="Order"
                                                                   asp-action="CheckoutDetails"
                                                                   asp-route-sid="@trialPlanDetails.Sid"
                                                                   asp-route-pid="@trialPlanDetails.Bid"
                                                                   class="btn btn-primary btn-lg w-100 mb-3">
                                                                    Subscribe Now
                                                                </a>
                                                            </div>
                                                        </div>
                                                        
                                                        <div class="d-flex flex-column justify-content-between mb-2">
                                                            <div class="mb-3">
                                                                Features Includes in this @trialPlanDetails.SubscriptionName
                                                            </div>
                                                            <ul class="list-unstyled pricing-features-list">
                                                                @{
                                                                    List<string> featureList1 =
                                                                    trialPlanDetails.Details?
                                                                    .Split('.')
                                                                    .Select(s => s.Trim())// Recommended: cleans up leading/trailing spaces
                                                                    .Where(e => !String.IsNullOrEmpty(e))
                                                                    .ToList()
                                                                    ?? new List<string>();

                                                                    foreach (var item in featureList1)
                                                                    {
                                                                        <li class="d-flex align-items-start gap-3 mb-2">
                                                                            <span class="pricing-check mt-2">
                                                                                <i class="bi bi-patch-check-fill"></i>
                                                                            </span>
                                                                            <span>@item</span>
                                                                        </li>
                                                                    }
                                                                }
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        index = index + 1;
                                        string active = (detail.IsRecommended == 1)
                                        ? "active"
                                        : "";
                                        <div class="col-lg-4 col-md-6 col-sm-12">
                                            <div class="card bg-light mb-3 rounded-custom h-100 @active">
                                                <div class="card-body card-inner-canvas d-flex flex-column p-4 h-100">
                                                   <div class="d-flex justify-content-between flex-column mb-2 card-header">
                                                       <h4 class="plan-name mb-0">
                                                           @detail.SubscriptionName
                                                       </h4>
                                                       @if (detail.IsRecommended == 1)
                                                         {
                                                           <span class="badge-top">
                                                               Recommended
                                                           </span>
                                                         }
                                                   
                                                       <div class="pricing-amount mb-2">
                                                           <span class="currency">₹</span>
                                                           @{
                                                             string planName = "Monthly";
                                                             string amount = plan.PlanName switch
                                                                {
                                                                  "Monthly" => detail.Amount + "",
                                                                  "Quarterly" => detail.Amount / 3 + "",
                                                                  "Yearly" => detail.Amount / 12 + "",
                                                                  _ => 0 + ""
                                                                };
                                                           }
                                                           <span class="price-value">
                                                                @amount
                                                           </span>
                                                           <span class="duration">
                                                                / @planName
                                                           </span>
                                                       </div>
                                                       <p class="text-muted small mb-1 text-success">
                                                            Billing:₹@detail.Amount / @plan.PlanName
                                                       </p>
                                                       <!-- Addon Pack Cost and Count Info (Billing ) -->
                                                       @if (detail.PackCost > 0)
                                                          {
                                                              <p class="text-secondary small mb-1" style="font-size: 0.825rem;">
                                                                  <i class="bi bi-plus-circle-fill text-primary small me-1"></i>Add-on: <span class="fw-bold text-dark">₹@detail.PackCost</span> <span class="text-muted">(pack of @detail.PerpackCount persons)</span>
                                                              </p>
                                                          }
                                                          else
                                                          {                                                            
                                                          <p class="mb-1" style="line-height: 1.25rem;">&nbsp;</p>
                                                          }
                                                          <p class="text-muted small mb-2">
                                                              Feature for up to @detail.MaximumMemberCount users
                                                          </p>
                                                          <div class="mt-2 pt-2">
                                                              <a asp-controller="Order"
                                                                 asp-action="CheckoutDetails"
                                                                 asp-route-sid="@detail.Sid"
                                                                 asp-route-pid="@plan.PlanId"
                                                                 class="btn btn-primary btn-lg w-100 mb-3">
                                                                  Subscribe Now
                                                              </a>
                                                          </div>                                                       
                                                    </div>
                                                   <div class="d-flex flex-column justify-content-between mb-2">
                                                       <div class="mb-3">
                                                            Features Includes in this @detail.SubscriptionName
                                                        </div>
                                                        <ul class="list-unstyled pricing-features-list">
                                                            @{
                                                                List<string> featureList =
                                                                detail.Details?
                                                                .Split('.')
                                                                .Where(e => !String.IsNullOrEmpty(e))
                                                                .ToList()
                                                                ?? new List<string>();
                                                                foreach (var item in featureList)
                                                                {
                                                                    <li class="d-flex align-items-start gap-3 mb-2">
                                                                        <span class="pricing-check mt-2">
                                                                            <i class="bi bi-patch-check-fill"></i>
                                                                        </span>
                                                                        <span>@item</span>
                                                                    </li>
                                                                }
                                                            }
                                                        </ul>
                                                   </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- PLAN BODY -->
    @foreach (var plan in Model.Plans ?? Enumerable.Empty<PlanMaster>())
    {
        var index = 0;

        <div class="productPlan_body"
             id="plan-@plan.PlanId-body"
             style="@(plan == Model.Plans?.First() ? "display:block;" : "display:none;")">

            <div class="row justify-content-center">

                @if (Model.SubscriptionDetails != null)
                {
                    @foreach (var detail in Model.SubscriptionDetails.Where(d => d.Bid == plan.PlanId))
                    {
                        @if (detail.Amount != 0)
                        {
                            @if (ViewBag.SubscriptionWarning != null && index == 0)
                            {
                                <div class="alert alert-warning mb-3" role="alert">
                                    <p>@ViewBag.SubscriptionWarning</p>
                                </div>
                            }

                            @if (index == 0 && trialPlanDetails.Sbfid != 0)
                            {
                                <div class="col-lg-4 col-md-6 col-sm-12">
                                    <div class="card mb-3 rounded-custom h-100">
                                        <div class="card-body card-inner-canvas d-flex flex-column p-4 h-100">
                                           <div class="d-flex flex-column justify-content-between mb-2">
                                               <h4 class="plan-name mb-0">
                                                  @trialPlanDetails.SubscriptionName
                                               </h4>                                           
                                               <div class="pricing-amount mb-2">
                                                  <span class="currency">₹</span>
                                                  <span class="price-value">0</span>
                                               </div>                                                
                                               <p class="text-muted small mb-2">
                                                    Feature for up to @trialPlanDetails.MaximumMemberCount users
                                               </p>
                                               <div class="mt-2 pt-2">
                                                    <a asp-controller="Order"
                                                       asp-action="CheckoutDetails"
                                                       asp-route-sid="@trialPlanDetails.Sid"
                                                       asp-route-pid="@trialPlanDetails.Bid"
                                                       class="btn btn-primary btn-lg w-100 mb-3">
                                                        Subscribe Now
                                                    </a>
                                                </div>
                                           </div>
                                           <div class="d-flex flex-column justify-content-between mb-2">
                                                <div class="mb-3">
                                                    Features Includes in this @trialPlanDetails.SubscriptionName
                                                </div>
                                                <ul class="list-unstyled pricing-features-list">
                                                    @{
                                                      List<string> featureList1 =
                                                      trialPlanDetails.Details?
                                                      .Split('.')
                                                      .Select(s => s.Trim())
                                                      .Where(e => !String.IsNullOrEmpty(e))
                                                      .ToList()
                                                       ?? new List<string>();
                                                       foreach (var item in featureList1)
                                                          {
                                                            <li class="d-flex align-items-start gap-3 mb-2">
                                                               <span class="pricing-check mt-2">
                                                                  <i class="bi bi-patch-check-fill"></i>
                                                               </span>
                                                               <span>@item</span>
                                                            </li>
                                                          }
                                                      }
                                                 </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            index = index + 1;

                            string active = (detail.IsRecommended == 1)
                            ? "active"
                            : "";

                            <div class="col-lg-4 col-md-6 col-sm-12">
                                <div class="card mb-3 rounded-custom h-100 @active">
                                    <div class="card-body card-inner-canvas d-flex flex-column p-4 h-100">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h4 class="plan-name mb-0">
                                               @detail.SubscriptionName
                                            </h4>
                                            @if (detail.IsRecommended == 1)
                                              {
                                                <span class="badge-top">
                                                    Recommended
                                                </span>
                                            }                                            
                                            <div class="pricing-amount mb-2">
                                                <span class="currency">₹</span>
                                                @{
                                                    string planName = "Monthly";
                                                    string amount = plan.PlanName switch
                                                    {
                                                        "Monthly" => detail.Amount + "",
                                                        "Quarterly" => detail.Amount / 3 + "",
                                                        "Yearly" => detail.Amount / 12 + "",
                                                        _ => 0 + ""
                                                    };
                                                }
                                                <span class="price-value">@amount</span>
                                                <span class="duration">/ @planName</span>
                                            </div>
                                            <p class="text-muted small mb-1 text-success">
                                                Billing:₹@detail.Amount / @plan.PlanName
                                            </p>
                                            <p class="text-muted small mb-2">
                                                Feature for up to @detail.MaximumMemberCount users
                                            </p>
                                            <div class="mt-2 pt-2">
                                                <a asp-controller="Order"
                                                   asp-action="CheckoutDetails"
                                                   asp-route-sid="@detail.Sid"
                                                   asp-route-pid="@plan.PlanId"
                                                   class="btn btn-primary btn-lg w-100 mb-3">
                                                    Subscribe Now
                                                </a>
                                            </div>
                                        </div>
                                        <div class="d-flex flex-column justify-content-between mb-2">
                                            <div class="mb-3">
                                                Features Includes in this @detail.SubscriptionName
                                            </div>
                                            <ul class="list-unstyled pricing-features-list">

                                                @{
                                                    List<string> featureList =
                                                    detail.Details?
                                                    .Split('.')
                                                    .Where(e => !String.IsNullOrEmpty(e))
                                                    .ToList()
                                                    ?? new List<string>();

                                                    foreach (var item in featureList)
                                                    {
                                                        <li class="d-flex align-items-start gap-3 mb-2">

                                                            <span class="pricing-check mt-2">
                                                                <i class="bi bi-patch-check-fill"></i>
                                                            </span>

                                                            <span>@item</span>

                                                        </li>
                                                    }
                                                }

                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    }
    <!-- COMPARISON TABLE SECTION -->
    
    <section class="py-5 bg-light bg-opacity-50">
        <div class="container">
            <!-- Heading -->
            <div class="text-center mb-5">
                <h2 class="fw-black text-dark display-6 mb-2" style="font-weight: 800;">Compare Pricing Plans</h2>
                <p class="text-secondary mx-auto mb-0 style-desc">Choose the plan that best fits your workforce size and business requirements.</p>
            </div>

            <!-- Table Container Card -->
            <div class="table-responsive bg-white rounded-4 shadow-sm border p-4">
                <table class="table align-middle text-center mb-0" id="comparisonPlanTable">
                    <thead>
                        <tr class="border-0">
                            <!-- Feature Anchor Column -->
                            <th class="text-start border-0 alignment-top pb-4" style="width: 28%; vertical-align: bottom;">
                                <div class="ps-2">
                                    <p class="text-muted small uppercase fw-bold mb-0 text-uppercase tracking-wider" style="font-size: 0.75rem; letter-spacing: 1px;">Core Comparison</p>
                                    <h4 class="h5 fw-bold text-dark mb-0">Platform Features</h4>
                                </div>
                            </th>

                            <!-- 1. Trial Plan Header -->
                            @if (trialPlanDetails != null && trialPlanDetails.Sbfid != 0)
                            {
                                <th class="border-0 pb-4" style="width: 24%;">
                                    <div class="bg-light bg-opacity-40 border rounded-3 p-3 position-relative">
                                        <h3 class="h5 fw-bold text-dark mb-0">@trialPlanDetails.SubscriptionName</h3>
                                    </div>
                                </th>
                            }

                            <!-- 2. Dynamic Table Headers (Classic / Enterprise) -->
                            @foreach (var plan in Model.Plans ?? Enumerable.Empty<PlanMaster>())
                            {
                                @if (Model.SubscriptionDetails != null)
                                {
                                    @foreach (var detail in Model.SubscriptionDetails.Where(d => d.Bid == plan.PlanId && d.Amount != 0))
                                    {
                                        string highlightClass = (detail.IsRecommended == 1) ? "bg-success bg-opacity-10 rounded-top-4 border-start border-end border-top" : "border-0 pb-4";

                                        <th class="@highlightClass pb-4 plan-header-cell" data-plan-id="@plan.PlanId" style="width: 24%;">
                                            <div class="@(detail.IsRecommended == 1 ? "bg-white shadow-sm border border-success border-opacity-20" : "bg-light bg-opacity-40 border") rounded-3 p-3 position-relative">
                                                @if (detail.IsRecommended == 1)
                                                {
                                                    <span style="font-size: 0.65rem; letter-spacing: 0.5px;" class="badge bg-warning text-white rounded-pill position-absolute top-0 start-50 translate-middle text-uppercase px-2.5 py-1">Most Popular</span>
                                                    <h3 class="h5 fw-bold text-success mb-0 mt-1">@detail.SubscriptionName</h3>
                                                }
                                                else
                                                {
                                                    <h3 class="h5 fw-bold text-dark mb-0">@detail.SubscriptionName</h3>
                                                }
                                            </div>
                                        </th>
                                    }
                                }
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Financials Splitter -->
                        <tr class="bg-light">
                            @{
                                var totalColumns = (trialPlanDetails != null && trialPlanDetails.Sbfid != 0 ? 2 : 1);
                                if (Model.Plans != null && Model.SubscriptionDetails != null)
                                {
                                    foreach (var plan in Model.Plans)
                                    {
                                        totalColumns += Model.SubscriptionDetails.Count(d => d.Bid == plan.PlanId && d.Amount != 0);
                                    }
                                }
                            }
                            <td colspan="@totalColumns" class="text-start py-2.5 ps-3 fw-bold text-muted text-uppercase" style="font-size: 0.725rem; letter-spacing: 1px;">Financials &amp; Limits</td>
                        </tr>
                        <!-- Dynamic Row: Charges -->
                        <tr class="align-middle">
                            <td class="text-start fw-bold text-secondary ps-3 py-3.5 border-bottom">Charges</td>

                            <!-- Trial Charges -->
                            @if (trialPlanDetails != null && trialPlanDetails.Sbfid != 0)
                            {
                                <td class="py-3.5 border-bottom text-dark fs-5 text-muted">
                                    ₹0
                                    <span class="d-block text-muted fw-normal fs-7 mt-0.5" style="font-size: 0.75rem;">/ Free Trial</span>
                                </td>
                            }

                            <!-- Classic / Enterprise Charges -->
                            @foreach (var plan in Model.Plans ?? Enumerable.Empty<PlanMaster>())
                            {
                                @if (Model.SubscriptionDetails != null)
                                {
                                    @foreach (var detail in Model.SubscriptionDetails.Where(d => d.Bid == plan.PlanId && d.Amount != 0))
                                    {
                                        string cellBg = (detail.IsRecommended == 1) ? "bg-success bg-opacity-10 border-start border-end fw-bold" : "";
                                        
                                        decimal baseAmount = Convert.ToDecimal(detail.Amount);
                                        string calculatedAmount = plan.PlanName switch
                                        {
                                            "Monthly" => baseAmount.ToString("0.##"),
                                            "Quarterly" => (baseAmount / 3).ToString("0.##"),
                                            "Yearly" => (baseAmount / 12).ToString("0.##"),
                                            _ => baseAmount.ToString("0.##")
                                        };

                                        <td class="py-3.5 border-bottom text-dark fs-5 plan-data-cell @cellBg" data-plan-id="@plan.PlanId">
                                            ₹@calculatedAmount
                                            <span class="d-block text-muted fw-normal fs-7 mt-0.5" style="font-size: 0.75rem;">/ Month</span>
                                            <small class="d-block text-muted opacity-75 fw-normal" style="font-size: 0.65rem;">
                                                (Billing: ₹@detail.Amount / @plan.PlanName)
                                            </small>
                                        </td>
                                    }
                                }
                            }
                        </tr>
                      

                        <!-- Dynamic Row: Users -->
                        <tr class="align-middle">
                            <td class="text-start fw-bold text-secondary ps-3 py-3.5 border-bottom">Users</td>

                            @if (trialPlanDetails != null && trialPlanDetails.Sbfid != 0)
                            {
                                <td class="py-3.5 border-bottom text-muted">
                                    @trialPlanDetails.MaximumMemberCount Users
                                </td>
                            }

                            @foreach (var plan in Model.Plans ?? Enumerable.Empty<PlanMaster>())
                            {
                                @if (Model.SubscriptionDetails != null)
                                {
                                    @foreach (var detail in Model.SubscriptionDetails.Where(d => d.Bid == plan.PlanId && d.Amount != 0))
                                    {
                                        string cellBg = (detail.IsRecommended == 1) ? "bg-success bg-opacity-10 border-start border-end fw-semibold" : "text-muted";

                                        <td class="py-3.5 border-bottom plan-data-cell @cellBg" data-plan-id="@plan.PlanId">
                                            @(detail.MaximumMemberCount + " Users")
                                        </td>
                                    }
                                }
                            }
                        </tr>

                    

                        <!-- Dynamic Row: Additional Users (Add-on) -->
                        <tr class="align-middle">
                            <td class="text-start fw-bold text-secondary ps-3 py-3.5 border-bottom">Additional Users</td>

                            <!-- Trial Plan Cell -->
                            @if (trialPlanDetails != null && trialPlanDetails.Sbfid != 0)
                            {
                                <td class="py-3.5 border-bottom text-muted">
                                    &mdash;
                                </td>
                            }

                            <!-- Classic / Enterprise Plans Dynamic Loop -->
                            @foreach (var plan in Model.Plans ?? Enumerable.Empty<PlanMaster>())
                            {
                                @if (Model.SubscriptionDetails != null)
                                {
                                    @foreach (var detail in Model.SubscriptionDetails.Where(d => d.Bid == plan.PlanId && d.Amount != 0))
                                    {
                                        string cellBg = (detail.IsRecommended == 1) ? "bg-success bg-opacity-10 border-start border-end" : "";

                                        <td class="py-3.5 border-bottom plan-data-cell @cellBg" data-plan-id="@plan.PlanId">
                                            @if (detail.PackCost > 0)
                                            {
                                            
                                                <span class="d-block fw-bold text-dark fs-5">
                                                    ₹@detail.PackCost
                                                </span>

                                                
                                                <span class="d-block text-muted mt-0.5" style="font-size: 0.75rem;">
                                                    (pack of @detail.PerpackCount persons)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">&mdash;</span>
                                            }
                                        </td>
                                    }
                                }
                            }
                        </tr>
                        <!-- Modules Layout Splitter -->
                        <tr class="bg-light">
                            <td colspan="@totalColumns" class="text-start py-2.5 ps-3 fw-bold text-muted text-uppercase" style="font-size: 0.725rem; letter-spacing: 1px;">Modules &amp; Operations</td>
                        </tr>

                        <!-- Helper Macro Pattern for Features to Avoid Hardcoding Columns -->
                        @{
                            var rowFeatures = new List<(string Name, bool Trial, bool Classic, bool Enterprise)>
                                                {
                                                ("Attendance Management", true, true, true),
                                                ("Payroll Management", true, true, true),
                                                ("Expenses / Advance Management", true, true, true),
                                                ("Leave Management", true, true, true),
                                                ("Onboarding Support", true, true, true),
                                                ("Exit Management", true, true, true),
                                                ("Mobile App", true, true, true),
                                                ("Statutory & Compliance", false, true, true),
                                                ("BI & Dashboard", false, true, true),
                                                ("Shift & Schedule Management", false, true, true),
                                                ("Security Access", false, true, true),
                                                ("Organogram", false, true, true)
                                                };

                            foreach (var feature in rowFeatures)
                            {
                                <tr class="align-middle">
                                    <td class="text-start fw-bold text-secondary ps-3 py-3.5 border-bottom">@feature.Name</td>

                                    @if (trialPlanDetails != null && trialPlanDetails.Sbfid != 0)
                                    {
                                        <td class="py-3.5 border-bottom">
                                            @if (feature.Trial)
                                            {
                                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                            }
                                            else
                                            {

                                                <span class="text-muted fw-light">&mdash;</span>
                                            }
                                        </td>
                                    }

                                    @foreach (var plan in Model.Plans ?? Enumerable.Empty<PlanMaster>())
                                    {
                                        @if (Model.SubscriptionDetails != null)
                                        {
                                            @foreach (var detail in Model.SubscriptionDetails.Where(d => d.Bid == plan.PlanId && d.Amount != 0))
                                            {
                                                string cellBg = (detail.IsRecommended == 1) ? "bg-success bg-opacity-10 border-start border-end" : "";
                                                bool isAvailable = detail.SubscriptionName.Contains("Enterprise") ? feature.Enterprise : feature.Classic;

                                                <td class="py-3.5 border-bottom plan-data-cell @cellBg" data-plan-id="@plan.PlanId">
                                                    @if (isAvailable)
                                                    {
                                                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                                    }
                                                    else
                                                    {

                                                        <span class="text-muted fw-light">&mdash;</span>
                                                    }
                                                </td>
                                            }
                                        }
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

