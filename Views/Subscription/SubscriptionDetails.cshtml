    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const radios = document.querySelectorAll('input[name="selectedPlan"]');

            radios.forEach((radio) => {

                radio.addEventListener("change", function () {
                    document.querySelectorAll('.productPlan_body').forEach(body => {
                        body.style.display = 'none';
                    });

                    const target = document.getElementById('plan-' + this.value + '-body');
                    if (target) target.style.display = 'block';
                });
            });

            // ✅ Show the first plan-body by default
            if (radios.length > 0) {
                const target = document.getElementById('plan-' + radios[0].value + '-body');
                if (target) target.style.display = 'block';
            }
        });


    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const radios = document.querySelectorAll(".plan-toggle-radio");
            const planBodies = document.querySelectorAll(".productPlan_body");

            // Initial animation class
            planBodies.forEach(body => {
                if (body.style.display !== "none") {
                    body.classList.add("plan-active");
                }
            });

            radios.forEach(radio => {

                radio.addEventListener("change", function () {

                    const targetId = "plan-" + this.value + "-body";

                    // Hide all with animation
                    planBodies.forEach(body => {

                        if (body.classList.contains("plan-active")) {

                            body.classList.remove("plan-active");
                            body.classList.add("plan-hide");

                            setTimeout(() => {
                                body.style.display = "none";
                                body.classList.remove("plan-hide");
                            }, 350);
                        }
                    });

                    // Show selected with delay
                    setTimeout(() => {

                        const activeBody = document.getElementById(targetId);

                        if (activeBody) {
                            activeBody.style.display = "block";

                            // trigger reflow
                            void activeBody.offsetWidth;

                            activeBody.classList.add("plan-active");
                        }

                    }, 360);

                });

            });

        });
    </script>
    <!-- JAVASCRIPT FOR TOGGLING BOTH CARDS AND TABLE -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const planRadios = document.querySelectorAll('input[name="selectedPlan"]');

            function updateTableAndCards(selectedPlanId) {
                // 1. Pricing card layouts toggle logic
                document.querySelectorAll('.productPlan_body').forEach(div => {
                    div.style.display = 'none';
                });
                const targetBody = document.getElementById(`plan-${selectedPlanId}-body`);
                if (targetBody) {
                    targetBody.style.display = 'block';
                }

                // 2. Table dynamic fields toggle logic (Headers & Data Columns)
                document.querySelectorAll('.plan-header-cell').forEach(cell => {
                    if (cell.getAttribute('data-plan-id') === selectedPlanId) {
                        cell.style.setProperty('display', 'table-cell', 'important');
                    } else {
                        cell.style.setProperty('display', 'none', 'important');
                    }
                });

                document.querySelectorAll('.plan-data-cell').forEach(cell => {
                    if (cell.getAttribute('data-plan-id') === selectedPlanId) {
                        cell.style.setProperty('display', 'table-cell', 'important');
                    } else {
                        cell.style.setProperty('display', 'none', 'important');
                    }
                });
            }

            // Active layout trigger on initial load
            const activeRadio = document.querySelector('input[name="selectedPlan"]:checked');
            if (activeRadio) {
                updateTableAndCards(activeRadio.value);
            }

            // Event listener for toggle switches
            planRadios.forEach(radio => {
                radio.addEventListener('change', function () {
                    updateTableAndCards(this.value);
                });
            });
        });
    </script>
    
    <script>
      $(window).on("load", function () {
        var hash = window.location.hash;
        if (!hash) return;

        var $targetItem = $(hash);
        if (!$targetItem.length) return;

        var $button = $targetItem.find(".accordion-button");
        var $collapse = $targetItem.find(".accordion-collapse");

        if ($button.length && $collapse.length) {
          var $accordion = $targetItem.closest(".accordion");

          // close other open accordions inside same parent
          if ($accordion.length) {
            $accordion.find(".accordion-collapse.show").not($collapse).removeClass("show");

            $accordion.find(".accordion-button").not($button).each(function () {
              $(this).addClass("collapsed").attr("aria-expanded", "false");
            });
          }

          // open target accordion
          $collapse.addClass("show");
          $button.removeClass("collapsed").attr("aria-expanded", "true");

          // smooth scroll
          setTimeout(function () {
            $("html, body").animate({
              scrollTop: $targetItem.offset().top - 20
            }, 500);
          }, 150);
        }
      });
    </script>
