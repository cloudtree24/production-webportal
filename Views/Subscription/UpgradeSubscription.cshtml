        // * Checks if an input field has a value. If not, adds a warning element below it.

        function validateField(inputId, message) {
        const inputElement = document.getElementById(inputId);
        // Find the warning element using the naming convention: [id]-warning
        const warningElement = document.getElementById(inputId + '-warning');

        // Clear previous state
        if (warningElement) {
            warningElement.textContent = '';
        }

        // Check if the field is empty (invalid)
        if (!inputElement || inputElement.value.trim() === "") {
            if (warningElement) {
                // Display the error message
                warningElement.textContent = '⚠️ ' + message;
            }
            return false;
        }

        // Valid: warningElement is already cleared above
        return true;
    }

