<script>

    @*function calc(val, usersPerPack, costPerPack) {*@
    function calc(val) {
       
                           // UI elements
                           const pCountElem = document.getElementById('pCount');
                           const uCountElem = document.getElementById('uCount');
                           const pCostElem  = document.getElementById('pCost');

                           @* let gstpercentage=parseFloat("@Model?.TaxPercentage");*@
                           let gstpercentage=parseFloat($('#hdntaxpercentage').val());
                           
                           const usersPerPack  = document.getElementById('usersPerPack');
                           const costPerPack  = document.getElementById('costPerPack');




                           const totalAmount  = document.getElementById('totalAmountDisplay');
                           const gstAmount  = document.getElementById('gstAmountDisplay');
                           const discountAmount  = document.getElementById('hdndiscountvalue');


                           const hdntotalvalue  = document.getElementById('totalValueHidden');
                           const hdntotaltaxvalue  = document.getElementById('totalTaxValuehidden');
                           // const taxAmtElem = document.getElementById('taxAmt_' + uid);// Tax UI


                           // Hidden inputs
                           
                           const hPackElem  = document.getElementById('hPack');
                           const hUsersElem = document.getElementById('hUsers');
                           const hCostElem  = document.getElementById('hCost');
                           // const hTaxElem   = document.getElementById('hTax_' + uid);  // Tax Hidden Input

                           // Get Tax Percentage from ViewBag
                           // const taxPercent = parseFloat('@ViewBag.TaxPercentage');


                           let currentPacks = parseInt(pCountElem.innerText);
                           let newPacks = Math.max(0, currentPacks + val);



                           // Calculations
                           let totalBaseCost = newPacks * parseFloat(costPerPack.value);
                           let totalUsers    = newPacks * parseInt(usersPerPack.value);
                           // let taxAmount     = (totalBaseCost * taxPercent) / 100;


                           // 🔹 Update UI
                           pCountElem.innerText = newPacks;
                           uCountElem.innerText = totalUsers;
                           pCostElem.innerText  = totalBaseCost.toFixed(2);
                           // taxAmtElem.innerText = taxAmount.toFixed(2); Display tax with 2 decimals


                            
                           // 🔥 Update hidden inputs
                           hPackElem.value  = newPacks;
                           hUsersElem.value = totalUsers;
                           hCostElem.value  = totalBaseCost.toFixed(2);
                           // hTaxElem.value   = taxAmount.toFixed(2); Send tax amount to controller

                            let prevamount=parseFloat($('#totalBaseAmountHidden').val());
                          
                            
                           let discount=parseFloat(discountAmount.value)|| 0;
                           let newtotalValue=prevamount+totalBaseCost-discount;
                           let newtaxamount=(newtotalValue*gstpercentage)/100;

                           totalAmount.innerText=(newtotalValue+newtaxamount).toFixed(2);
                           gstAmount.innerText="₹"+newtaxamount.toFixed(2);

                            hdntotalvalue.value  = (newtotalValue+newtaxamount).toFixed(2);
                           hdntotaltaxvalue.value = newtaxamount.toFixed(2);

                       }


        $(document).ready(function () {

            const postalCodeInput = document.getElementById('postalCode');
    const warningElement = document.getElementById('postalCode-warning');

    if (postalCodeInput) {
        // Function to handle the input and show/hide the temporary warning
        const handleInputFiltering = (event) => {
            const currentValue = event.target.value;
            const sanitizedValue = currentValue.replace(/[^\d]/g, ''); // Keep only digits

            if (currentValue !== sanitizedValue) {
                // If a non-digit character was detected and removed

                // 1. Set the clean value back to the input
                event.target.value = sanitizedValue;

                // 2. Display the temporary warning
                if (warningElement) {
                    warningElement.textContent = '❌ Only numbers are allowed in the Postal Code.';
                }

                // 3. Clear the warning after a short delay (e.g., 2 seconds)
                setTimeout(() => {
                    if (warningElement) {
                        warningElement.textContent = '';
                    }
                }, 2000);

            } else if (currentValue.length > 6) {
                // Handle case where maxlength might be bypassed or copy-pasted (though HTML limits it)
                event.target.value = currentValue.slice(0, 6);
            }
        };

        // Attach listeners for both keypress (faster feedback) and input (paste/autofill)
        postalCodeInput.addEventListener('input', handleInputFiltering);
    }









            // Helper function to attach event listeners to a field
    function attachFieldListener(id, msg) {
        const element = document.getElementById(id);
        if (element) {
            const eventType = (element.tagName === 'SELECT' ? 'change' : 'input');
            element.addEventListener(eventType, () => {
                // Assuming validateField is defined globally or within this scope
                validateField(id, msg);
            });
        }
    }

    // Attach listeners for all required fields when the DOM is ready
    attachFieldListener('plan', 'Please select a Plan.');
    attachFieldListener('billing', 'Please select a Billing Cycle.');
    attachFieldListener('address', 'Billing Address is required.');
    attachFieldListener('city', 'City is required.');
    attachFieldListener('postalCode', 'Postal Code is required.');



