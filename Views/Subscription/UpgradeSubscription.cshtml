        function clearWarning() {
            $('#plan-warning').text('').hide();
        }

        // Clear warning whenever the Plan selection changes
        $('#plan').on('change', function() {
            clearWarning();
        });

       @* // 1. Listen for changes on the Billing Cycle dropdown
        $('#billing,#plan').on('change', function () {

            var selectedPlanId = $('#plan').val();
            var selectedBillingId = $('#billing').val();

            // Clear previous details and any existing warning
