            var companyType = $("#companyType").val();

            if (!pid || !dmcode) {
                alert("Please select a product and enter coupon code!");
                return;
            }

            $.ajax({
                url: '/Order/GetDiscountDetailsByCode',
                type: 'GET',
                data: {
                    pid: pid,
                    sid: sid,
                    companyType: companyType,
                    dmcode: dmcode
                },
                success: function (response) {

                    if (response && response.discountType) {
                        
                        @*// ----- Get base amount -----
                        var baseAmount = parseFloat(
                            $("#baseAmountDisplay").text().replace(/[₹,]/g, "")
                        ) || 0;*@
                        const hdntotaltaxvalue  = document.getElementById('totalTaxValuehidden');
                        var baseAmount=parseFloat($("#totalBaseAmountHidden").val());
                        var addonamount=parseFloat($('#hCost').val()??0);
                        baseAmount=addonamount+baseAmount;
                        // ----- Get GST percentage from text "GST (18%)" -----
                        var gstText = $("#gstTextDisplay").text();
                        var gstPercent = parseFloat(gstText.match(/\d+/)) || 0;

                        var discountAmount = 0;

                        if (response.discountType.toLowerCase() === "fixed" ||
                            response.discountType.toLowerCase() === "fix") {
                            discountAmount = response.discountValue;
                        }
                        else if (response.discountType.toLowerCase() === "percentage") {
                            discountAmount = (baseAmount * response.discountValue) / 100;
                        }

                        discountAmount = parseFloat(discountAmount) || 0;
                        $('#hdndiscountvalue').val(discountAmount);
                        var newBaseAmount = baseAmount - discountAmount;
                        if (newBaseAmount < 0) newBaseAmount = 0;

                        var gstAmount = (newBaseAmount * gstPercent) / 100;
                        var totalAmount = newBaseAmount + gstAmount;

                        // ----- Update UI -----
                        $("#discountValue").text("₹" + discountAmount.toFixed(2));
                        $("#gstAmountDisplay").text("₹" + gstAmount.toFixed(2));
                        $("#totalAmountDisplay").text("₹" + totalAmount.toFixed(2));
                        $("#totalValueHidden").val(totalAmount.toFixed(2));
                        hdntotaltaxvalue.value=gstAmount.toFixed(2);
                       // $("#couponCode").val("");

