@model HCMPortal.ViewModel.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_LayoutWithoutEnquiryForm";
}

<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="description" content=""> 
    <meta name="author" content="">
    <title>Login page</title>

    <link rel="canonical" href="https://thecloudtree.ai/" />

    <link href="~/assets/styles/bootstrap/bootstrap.css" rel="stylesheet">
    <link href="~/assets/styles/bootstrap/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/fonts/font-awsome/css/all.min.css" rel="stylesheet">
    <link href="~/assets/datatable/css/datatables.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/assets/datatable/css/buttons.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/assets/styles/owl.theme.default.min.css" rel="stylesheet">
    <link href="~/assets/styles/owl.carousel.min.css" rel="stylesheet">
    <link href="~/assets/styles/style.min.css" rel="stylesheet" />

    <script src="https://www.google.com/recaptcha/api.js" async ></script>
    <script src="https://www.google.com/recaptcha/api.js"></script>

    <script src="~/assets/js/jquery.min.js"></script>
    <script src="~/assets/js/vanilla-toast.min.js"></script>
    <script src="~/assets/js/owl.carousel.min.js"></script>
</head>

<body>

    <div class="section_gap_large">
        <div class="container-lg">
            <div class="row">
                <div class="col-lg-5">
                    <div class="d-flex flex-column justify-content-center h-100">
                        <figure class="text-center">
                            <img width="710" class="img-fluid" src="~/assets/images/bg/lock.webp" alt="" title="Login">
                        </figure>
                        <div class="logIn-screen-testimonial owl-carousel">
                            <!-- Slide 1 -->
                            <div class="item text-center">
                                <p class="text-muted">Streamline your HR processes with ease and efficiency.</p>
                            </div>
                            <div class="item text-center">
                                <p class="text-muted">Manage employee data, attendance, and payroll—all in one place.</p>
                            </div>
                            <div class="item text-center">
                                <p class="text-muted">"Empowering your workforce through smart HR solutions."</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="login-wrapper">
                        <div class="login-content rounded-custom border w-100">
                            <div>
                                <h4 class="fw-bold">Login into your account</h4>
                                <p class="text-muted">Please sign in to your account below.</p>
                            </div>

                            @*  <form action="index.html" method="post"> *@
                            <form asp-action="PCustomerLogin" asp-controller="CustomerManagement" id="loginForm" method="post" autocomplete="off">
                            

                                <div class="row">
                                    <div class="col-12">
                                        <div class="mb-3">
                                            <label asp-for="PortalUserName" class="form-label"></label><span class="text-danger"> *</span>
                                            <div class="input-group">
                                                <input asp-for="PortalUserName" class="form-control border-end-0" placeholder="Email Address" />
                                                <span class="input-group-text no-bg">
                                                    <i class="bi bi-envelope"></i>
                                                </span>
                                            </div>
                                            <span asp-validation-for="PortalUserName" class="text-danger"></span>
                                        </div>
                                      
                                    </div>
                                    <div class="col-12">
                                        <div class="mb-3">
                                            <label asp-for="PortalPassword" class="form-label"></label><span class="text-danger"> *</span>
                                            <div class="input-group">
                                                <input asp-for="PortalPassword" type="password" id="portalPassword" class="form-control border-end-0" placeholder="Password" />
                                                <span class="input-group-text no-bg" id="togglePassword" style="cursor: pointer;">
                                                    <i class="bi bi-eye-slash" id="toggleIcon"></i>
                                                </span>
                                            </div>
                                            <span asp-validation-for="PortalPassword" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="g-recaptcha" data-sitekey="6LcP1r4rAAAAAHNiLqWilMZWVAroHkjaHZAEAIT9"></div>
                                    <span asp-validation-summary="ModelOnly" class="text-danger"></span>
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                </div>
                                <div class="mb-3">
                                    <div class="row">
                                        <div class="col-12 d-flex align-items-center justify-content-between">
                                            @*  <div class="form-check">
                          <input class="form-check-input" type="checkbox" value="" id="checkDefault">
                          <label class="form-check-label text-muted"  for="checkDefault">
                            Remember Me
                          </label>
                        </div>     *@                     
      
 
   
     
                        <div class="text-end">
                                                @* <a class="" asp-action="PCustomerForgotPassword" asp-controller="CustomerManagement">Forgot Password?</a> *@
                                                <a class="" asp-route="CustomerForgotPassword">Forgot Password?</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    @*  <a href="bookdemo.html" class="btn btn-primary w-100 btn-lg">Sign In</a> *@
                                    <button type="submit" class="btn btn-primary btn-lg px-5 py-3 fs-4 w-100">Sign In</button>
                                </div>

                                    <div class="mt-4 d-flex justify-content-center">
                                        <p class="text-muted">
                                            Don't have an account yet?
                                            @* <a href="register.html" class="">Create an
account</a> *@
                                            @* <a asp-action="RegisterHCMPortalCustomer" asp-controller="CustomerManagement" class="text-primary text-decoration-none">Create an account →</a> *@
                                        <a asp-route="CustomerRegister" class="text-primary text-decoration-none">Create an account →</a>
                                        </p>
                                    </div>
                            </form>
                        </div>


                    </div>
                </div>

            </div>
        </div>
    </div>
      
    <script>
        $(document).ready(function () {
          $('.logIn-screen-testimonial').owlCarousel({
            loop: true,
            margin: 10,
            nav: false,
            dots: true,
            autoplay: true,
            autoplayTimeout: 3000,
            autoplayHoverPause: true,
            items: 1
          });
        });

    </script>
    <script>
        document.getElementById("loginForm").addEventListener("submit", function () {
            let chk = document.getElementById("checkDefault").checked; // ✅ updated ID

            // create hidden input and append it
            let hidden = document.createElement("input");
            hidden.type = "hidden";
            hidden.name = "RememberMe";  // must match controller action parameter
            hidden.value = chk;          // "true" if checked, "false" if not
            this.appendChild(hidden);
        });
    </script>
    <script>
            $(document).on("click", "#togglePassword", function () {
            var $password = $("#portalPassword");
            var $icon = $("#toggleIcon");

            if ($password.attr("type") === "password") {
                $password.attr("type", "text");
                $icon.removeClass("bi-eye-slash").addClass("bi-eye");
            } else {
                $password.attr("type", "password");
                $icon.removeClass("bi-eye").addClass("bi-eye-slash");
            }
        });



    </script>

</body>

</html>
@{
    if (ViewBag.Success != null)
    {
        <script type="text/javascript">

            vt.success("@ViewBag.Success", {
                title: "Successfull",
                position: "top-center",
                closable: true,
               focusable: true, duration: 10000,
                //callback: function () {
                //    vt.success()
                //}
            });
        </script>
    }
    if (ViewBag.Exception != null)
    {
        <script type="text/javascript">
            vt.error("@ViewBag.Exception", {
                title: "Alert",
                position: "top-center",duration: 10000,
                //callback: function () {
                //    vt.success()
                //}
            });
        </script>
    }
    if (ViewBag.Delete != null)
    {
        <script type="text/javascript">
            vt.warn("@ViewBag.Delete", {
                title: "Alert",
                position: "top-center",duration: 10000,
                //callback: function () {
                //    vt.success()
                //}
            });
        </script>
    }
}