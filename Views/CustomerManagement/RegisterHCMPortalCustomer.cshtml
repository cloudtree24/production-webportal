    <script>
        function showPrivacyModal() {

            let url = "https://www.thecloudtree.ai/privacy-policy";

            let iframe = document.getElementById("privacyFrame");
            //let loader = document.getElementById("privacyLoader");

            // Reset UI
           // loader.style.display = "flex";
            iframe.style.display = "none";
            iframe.src = "";

            // Load the privacy-policy page
            iframe.src = url;

            // When iframe content loads, hide loader
            iframe.onload = function () {
               // loader.style.display = "none";
                iframe.style.display = "block";
            };

            // Show modal
            var modal = new bootstrap.Modal(document.getElementById('privacyModal'));
            modal.show();
        }
</script>
    <script>
        window.addEventListener("pageshow", function (event) {
            if (event.persisted || performance.getEntriesByType("navigation")[0].type === "back_forward") {
                document.querySelectorAll("form").forEach(f => f.reset());
            }
        });
    </script>

