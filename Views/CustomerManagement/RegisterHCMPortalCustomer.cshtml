               <form asp-action="RegisterHCMPortalCustomer" id="regForm" asp-controller="CustomerManagement" method="post" class="row g-3">
    <div class="col-md-6">
        <label asp-for="CompanyName" class="form-label"></label><span class="text-danger">*</span>
        <div class="input-group">
                                        <input asp-for="CompanyName" class="form-control border-end-0" placeholder="Business Name" data-val="true" data-val-required="Business name is required." />
            <span class="input-group-text no-bg"><i class="bi bi-bank"></i></span>
        </div>
        <span asp-validation-for="CompanyName" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ContactPersonName" class="form-label"></label><span class="text-danger">*</span>
        <div class="input-group">
                                        <input asp-for="ContactPersonName" class="form-control border-end-0" placeholder="Contact Person Name" data-val="true" data-val-required="Contact person is required." />
            <span class="input-group-text no-bg"><i class="bi bi-person"></i></span>
        </div>
        <span asp-validation-for="ContactPersonName" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="EmailAddress" class="form-label"></label><span class="text-danger">*</span>
        <div class="input-group">
            <input type="text" asp-for="EmailAddress" id="EmailAddress" class="form-control border-end-0" placeholder="Email Address" required />
            <span class="input-group-text no-bg"><i class="bi bi-envelope"></i></span>
        </div>
        <span asp-validation-for="EmailAddress" class="text-danger"></span>
        <div class="valid-feedback">Looks good!</div>
    </div>

    <div class="col-md-6">
        <label asp-for="Phonenumber" class="form-label"></label><span class="text-danger">*</span>
        <div class="input-group">
          <input asp-for="Phonenumber" id="Phonenumber" class="form-control border-end-0" placeholder="Phone Number" data-val="true" data-val-required="Phone number is required." />
            <span class="input-group-text no-bg"><i class="bi bi-telephone"></i></span>
        </div>
        <span asp-validation-for="Phonenumber" class="text-danger"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="IndustryTypeId" class="form-label"></label><span class="text-danger">*</span>
                                    <select asp-for="IndustryTypeId" class="form-select" asp-items="@(new SelectList(ViewBag.IndusryType, "Imid", "IndustryName"))" data-val="true" data-val-required="Industry name is required.">
            <option value="">Select Industry</option>
        </select>
        <span asp-validation-for="IndustryTypeId" class="text-danger"></span>
    </div>
     <div class="col-md-6">
        <label asp-for="Gstinnumber" class="form-label"></label>
        <div class="input-group">
            <input asp-for="Gstinnumber" id="gstin" class="form-control border-end-0" placeholder="Enter GST Number"/>
            <span class="input-group-text no-bg"><i class="bi bi-file-earmark-text"></i></span>
        </div>
        <span asp-validation-for="Gstinnumber" class="text-danger"></span>
    </div>
     <div class="col-md-6">
        <label asp-for="Pancard" class="form-label"></label>
        <div class="input-group">
            <input asp-for="Pancard" id="panNumber" class="form-control border-end-0" placeholder="Enter PAN Number"/>
            <span class="input-group-text no-bg"><i class="bi bi-person-vcard"></i></span>
        </div>
        <span asp-validation-for="Pancard" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CountryId"  class="form-label"></label><span class="text-danger">*</span>
        <select asp-for="CountryId" id="ddlCountry" class="form-select" asp-items="@(new SelectList(ViewBag.CountryList, "CountryId", "CountryName"))"  disabled>
            <option value="">Select Country</option>
        </select>
        
        <span asp-validation-for="CountryId" class="text-danger"></span>
        <input type="hidden" asp-for="CountryId">
    </div>
     <div class="col-md-6">
        <label asp-for="StateId"  class="form-label"></label><span class="text-danger">*</span>
                                    <select asp-for="StateId" id="ddlState" class="form-select" asp-items="@(new SelectList(ViewBag.StateList, "StateId", "StateName"))" data-val="true" data-val-required="State name is required.">
            <option value="">Select State</option>
        </select>
        <span asp-validation-for="StateId" class="text-danger"></span>
    </div>
        <div class="col-md-6">
        <label asp-for="City" class="form-label"></label><span class="text-danger">*</span>
        <div class="input-group">
                                        <input asp-for="City" class="form-control border-end-0" placeholder="City" data-val="true" data-val-required="City name is required." />
            <span class="input-group-text no-bg"><i class="bi bi-building"></i></span>
        </div>
        <span asp-validation-for="City" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="PostalCode" class="form-label"></label><span class="text-danger">*</span>
        <div class="input-group">
            <input asp-for="PostalCode" id="PostalCode" type="number" class="form-control border-end-0" placeholder="Postal Code" required />
            <span class="input-group-text no-bg"><i class="bi bi-mailbox"></i></span>
        </div>
        <span asp-validation-for="PostalCode" class="text-danger"></span>
    </div>
        <div class="col-md-12">
        <label asp-for="Address" class="form-label"></label>
        <div class="input-group">
            <input asp-for="Address" class="form-control border-end-0" placeholder="Address" />
            <span class="input-group-text no-bg"><i class="bi bi-geo-alt"></i></span>
        </div>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
           
    <div class="col-12 mt-3">
    <div class="g-recaptcha" data-sitekey="6LcP1r4rAAAAAHNiLqWilMZWVAroHkjaHZAEAIT9"></div>
    <span asp-validation-summary="ModelOnly" class="text-danger"></span>
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
     </div>
    <div class="col-md-12">
