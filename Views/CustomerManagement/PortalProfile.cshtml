                        var countryId = parseInt($(this).val());

                        if (!isNaN(countryId) && countryId > 0) {
                            var ddlState = $('#ddlState');
                            ddlState.empty();
                            ddlState.append($("<option></option>").val('').html('Please wait ...'));

                            $.ajax({
                                url: '/CustomerManagement/GetStateList',
                                type: 'GET',
                                dataType: 'json',
                                data: { countryId: countryId },
                                success: function (states) {
                                    ddlState.empty(); // Clear the please wait
                                    ddlState.append($("<option></option>").val('').html('Select State'));
                                    $.each(states, function (i, state) {
                                        ddlState.append($("<option></option>").val(state.stateId).html(state.stateName));
                                    });
                                },
                                error: function () {
                                    alert('Error retrieving states!');
                                }
                            });
                        } else {
                            $('#ddlState').empty();
                            $('#ddlState').append($("<option></option>").val('').html('Select'));
                        }
                    });

         $("#currentPassword").on("blur", function () {

        var enteredPassword = $(this).val().trim();
        var $error = $("#currentPasswordError");
        var $submitBtn = $("#submitBtn");

        if (enteredPassword === "") {
            $error.text("Current password is required.").show();
            $submitBtn.prop("disabled", true);
            return;
        }

        $.ajax({
            url: '/CustomerManagement/ValidateCurrentPassword',
            type: 'POST',
            data: { currentPassword: enteredPassword },
            success: function (isValid) {
                
                if (isValid === true) {
                  $error.hide().text("");
                    $submitBtn.prop("disabled", false);
                } else {
                    $error.text("Wrong password! Enter correct one.").show();
                    $submitBtn.prop("disabled", true);
                }
            },
            error: function () {
                $error.text("Unable to validate password. Try again.").show();
                $submitBtn.prop("disabled", true);
            }
        });
    });


