         $("#profileImageInput").change( function (event) {

                const file = event.target.files[0];
                const preview = document.getElementById("profileImagePreview");

                if (file) {
                    const fileType = file.type; // Get the file type

                    // Check if the file type is either 'image/jpeg' or 'image/png'
                    if (fileType === "image/jpeg" || fileType === "image/png"||fileType === "image/jpg") {
                        const reader = new FileReader();

                            reader.onload = function (e) {
                preview.src = e.target.result; // Correct: use the file data URL
            };


                        reader.readAsDataURL(file); // Read the file as a data URL
                    } else {
                        // If the file is not JPEG or PNG, show an alert
                        alert("Please upload a valid image file (JPEG, PNG or JPG only).");
                         event.target.value = "";
                        @* preview.src = "~/Pictures/user_icon.png"; // Set the default image *@
                        preview.src = "~/assets/images/user_icon.png"; // Set the default image
                    }
                }
                else {
                    // If no file is selected, show the default image
                    preview.src = "/assets/images/user_icon.png";
                }
            });
    });

</script>

<script>
        document.addEventListener("DOMContentLoaded", function () {

            // Store the original field values when the page loads
            const originalData = {};
            document.querySelectorAll(".editable-field").forEach(function (el) {
                if (el.name) {
                    originalData[el.name] = el.value;
                }
            });

            // Hide file input initially
            document.getElementById("imageUpload").classList.add("d-none");

            // Handle Edit click
            document.getElementById("btnEdit").addEventListener("click", function () {
                document.querySelectorAll(".editable-field").forEach(function (el) {
                    const tag = el.tagName.toLowerCase();
                    if (tag === "input" || tag === "textarea") {
                        el.removeAttribute("readonly");
                    }
                    if (tag === "select") {
                        el.removeAttribute("disabled");
                    }
                });

                document.getElementById("imageUpload").classList.remove("d-none");

                this.classList.add("d-none");
                document.getElementById("btnSave").classList.remove("d-none");
                document.getElementById("btnCancel").classList.remove("d-none");
            });

            // Handle Cancel click
            document.getElementById("btnCancel").addEventListener("click", function () {
                // Restore original values
                document.querySelectorAll(".editable-field").forEach(function (el) {
                    if (el.name && originalData.hasOwnProperty(el.name)) {
                        el.value = originalData[el.name];
                    }
                });

                // Disable fields again
                document.querySelectorAll(".editable-field").forEach(function (el) {
                    if (el.tagName === "INPUT" || el.tagName === "TEXTAREA") {
                        el.setAttribute("readonly", true);
                    }
                    if (el.tagName === "SELECT") {
                        el.setAttribute("disabled", true);
                    }
                });
                // remove the error message
                document.querySelectorAll("span.text-danger").forEach(function (span) {
        span.textContent = "";
    });
                // Hide file input again
                document.getElementById("imageUpload").classList.add("d-none");

                // Toggle buttons
                this.classList.add("d-none");
                document.getElementById("btnSave").classList.add("d-none");
                document.getElementById("btnEdit").classList.remove("d-none");


                // Reset profile image preview if changed
                const imgPreview = document.getElementById('profileImagePreview');
                if (imgPreview && originalData["profileImagePreviewSrc"]) {
                    imgPreview.src = originalData["profileImagePreviewSrc"];
                }


            });

            // Handle image preview
            window.previewProfileImage = function (input) {
                if (input.files && input.files[0]) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        document.getElementById('profileImagePreview').src = e.target.result;
                    };
                    reader.readAsDataURL(input.files[0]);
                }
            };

            // Store original image source too
            const imgPreview = document.getElementById('profileImagePreview');
            if (imgPreview) {
                originalData["profileImagePreviewSrc"] = imgPreview.src;
            }

