<script>
    const toggle = document.getElementById('billingToggle');
    const monthlyPlan = document.getElementById('monthly-plan');
    const yearlyPlan = document.getElementById('yearly-plan');

    toggle.addEventListener('change', function () {
      if (this.checked) {
        // Show Yearly, Hide Monthly
        yearlyPlan.style.display = 'block';
        monthlyPlan.style.display = 'none';
      } else {
        // Show Monthly, Hide Yearly
        monthlyPlan.style.display = 'block';
        yearlyPlan.style.display = 'none';
      }
    });

</script>
<script>
    function showPrivacyModal() {

        let url = "https://www.thecloudtree.ai/privacy-policy";

        let iframe = document.getElementById("privacyFrame");
        //let loader = document.getElementById("privacyLoader");

        // Reset UI
       // loader.style.display = "flex";
        iframe.style.display = "none";
        iframe.src = "";

        // Load the privacy-policy page
        iframe.src = url;

        // When iframe content loads, hide loader
        iframe.onload = function () {
           // loader.style.display = "none";
            iframe.style.display = "block";
        };

        // Show modal
        var modal = new bootstrap.Modal(document.getElementById('privacyModal'));
        modal.show();
    }
</script>

