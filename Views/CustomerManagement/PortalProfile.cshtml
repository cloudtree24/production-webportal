           // Elements
     document.getElementById('btnDeactivateAccount').addEventListener('click', function () {

        const reason = document.getElementById("deleteReason").value.trim();
        const privacyChecked = document.getElementById("privacyCheck").checked;
        const recaptchaResponse = grecaptcha.getResponse();

        // Validation 1 – Reason required
        if (reason.length === 0) {
            showFeedbackModal("warning", "Warning", "Please enter the reason for deleting your account.");
            return;
        }

        // Validation 2 – Privacy Policy must be accepted
        if (!privacyChecked) {
            showFeedbackModal("warning", "Warning", "You must accept the Privacy Policy before deleting your account.");
            return;
        }

        // Validation 3 – reCAPTCHA required
        if (!recaptchaResponse) {
            showFeedbackModal("warning", "Warning", "Please complete the reCAPTCHA verification.");
            return;
        }

        // If everything is valid → now show confirmation modal
        const modal = new bootstrap.Modal(document.getElementById('deactivateAccountModal'));
        modal.show();
    });



         document.getElementById('confirmDeactivateBtn').addEventListener('click', function () {
             
        let reason = document.getElementById('deleteReason').value.trim();
         let recaptchaToken = document.getElementById("g-recaptcha-response").value;

        $.ajax({
            url: '/CustomerManagement/DeleteAccount',
            type: 'POST',
            data: { reason: reason,
             "g-recaptcha-response": recaptchaToken
            },

            success: function (response) {
                
                $('#deactivateAccountModal').modal('hide');

                if (response.isSuccess) {
                    showFeedbackModal("success", "Success", response.message);
                     window.reloadAfterModal = true;
                } else {
                    showFeedbackModal("warning", "Warning", response.message);
                     window.reloadAfterModal = false;
                }
            },

            error: function () {
                $('#deactivateAccountModal').modal('hide');
                showFeedbackModal("danger", "Error", "Something went wrong!");
                window.reloadAfterModal = false;
            }
        });
    });

        $('#feedbackModal').on('hidden.bs.modal', function () {
        if (window.reloadAfterModal === true) {
            location.reload();
        }
    });

     // Feedback Modal Function
     function showFeedbackModal(type, title, message) {
         let icon = document.getElementById("feedbackIcon");
         let modalTitle = document.getElementById("feedbackTitle");
         let modalMessage = document.getElementById("feedbackMessage");

        icon.className = "bi me-2";

    // Set icon based on type
    if (type === "success") {
        icon.classList.add("bi-check-circle-fill", "text-success");
    }
    else if (type === "danger") {
        icon.classList.add("bi-x-circle-fill", "text-danger");
    }
    else if (type === "warning") {
        icon.classList.add("bi-exclamation-triangle-fill", "text-warning");
    }

         modalTitle.innerText = title;
         modalMessage.innerText = message;

         let modal = new bootstrap.Modal(document.getElementById("feedbackModal"));
         modal.show();
     }




</script>
