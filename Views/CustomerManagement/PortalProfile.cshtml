<script>
    let otpVerified = false;

    $("#btnSave").on("click", function (e) {
        
        e.preventDefault(); // VERY IMPORTANT
        @*  if (!form.valid()) {
        // ❌ Validation failed → DO NOT send OTP
        return;
    } *@

    // 🔹 Extra safety: check if any asp-validation span has text
    if (hasAspNetValidationErrors()) {
        return;
    }
        const oldEmail = $("#hiddenOEmail").val();
        const newEmail = $("#emailAddress").val();

        const oldUserName = $("#hiddenOldUserName").val();
        const newUserName = $("#userName").val();

        if (oldEmail !== newEmail || oldUserName !== newUserName) {
            sendOtp();
        } else {
            otpVerified = true;
            submitProfileForm();
        }
    });

    function sendOtp() {
        $.post('/CustomerManagement/SendOtp', function (res) {
            if (res.success) {
                $("#otpModal").modal("show"); // ✅ NOW IT WILL SHOW
            } else {
                alert(res.message);
            }
        });
    }

    $("#verifyOtpBtn").on("click", function () {
        const otp = $("#otpInput").val();

        $.post('/CustomerManagement/VerifyOtp', { otp: otp }, function (res) {
            if (res.success) {
                otpVerified = true;

                $("#verifyOtpBtn").prop("disabled", true);
                $("#otpModal").modal("hide");

                submitProfileForm(); // FINAL submit
            } else {
                $("#otpError").text("Invalid OTP");
            }
        });
    });

    function submitProfileForm() {
        // Enable disabled selects before submit
        $("#profileForm select:disabled").prop("disabled", false);

        $("#profileForm")[0].submit(); // PURE HTML submit
    }





            function hasAspNetValidationErrors() {
        let hasError = false;

        $("#profileForm span.text-danger").each(function () {
            if ($(this).text().trim().length > 0) {
                hasError = true;
                return false; // break loop
            }
        });

        return hasError;
    }

</script>

