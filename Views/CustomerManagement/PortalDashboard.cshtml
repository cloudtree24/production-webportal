        function initializeResourceUsageChart(used, total) {
        // 1. Explicitly DESTROY any existing chart instance
        if (resourceUsageChart) {
            resourceUsageChart.destroy();
            resourceUsageChart = null;
        }

        const chartContainer = document.querySelector("#resource_usage_chart");
        if (!chartContainer) return;

        // --- LOGIC FOR NO SUBSCRIPTION ---
        var isInactive = (total <= 0);

        var chartSeries = isInactive ? [1] : [used, Math.max(0, total - used)];
        var chartLabels = isInactive ? ['Activate A Plan To Unlock User Allotments.'] : ['Registered Employees', 'Remaining Capacity'];
        var chartColors = isInactive ? ['#D3D3D3'] : undefined; // Grey color if inactive
        var centerLabel = isInactive ? 'No Active Subscription' : 'Total Allotted';

        var options = {
            series: chartSeries,
            chart: {
                id: 'resource_usage_chart',
                type: 'donut',
                height: 350
            },
            colors: chartColors,
            labels: chartLabels,
            plotOptions: {
                pie: {
                    donut: {
                        size: '65%',
                        labels: {
                            show: true,
                            total: {
                                show: true,
                                label: centerLabel,
                                color: isInactive ? '#FF0000' : '#373d3f', // Optional: Red text for warning
                                formatter: function (w) {
                                    // If inactive, return empty string or specific text under the label
                                    if (isInactive) return "";
                                    return (w.globals.series[0] + w.globals.series[1]).toString();
                                }
                            }
                        }
                    }
                }
            },
            // Disable tooltips if inactive to prevent showing "1 Employees" on the grey ring
            tooltip: {
                enabled: !isInactive,
                y: {
                    formatter: function (value) {
                        return value + " Employees";
                    }
                }
            },
            legend: {
                position: 'bottom'
            }
        };

        resourceUsageChart = new ApexCharts(chartContainer, options);
        resourceUsageChart.render();

        // --- BANNER/INFO LINE LOGIC ---
        // Assuming you have a div for the banner, e.g., <div id="subscription-banner"></div>
        const banner = document.getElementById("subscription-banner");
        if (banner) {
            if (isInactive) {
                banner.innerHTML = "<strong>Activate a plan to unlock user allotments.</strong>";
                banner.style.display = "block";
            } else {
                banner.style.display = "none";
            }
        }
    }

    // Ensure this runs once all other scripts and the DOM are ready
    $(document).ready(function () {
        // 1. INITIAL SETUP
        // Assuming initial data is available via the Razor Model properties
        var initialUsed = @Model.employeeRegisteredCount;
        var initialTotal = @Model.totalAllotedemployeeRegisteredCount;

        // Initialize the chart instance on page load
        initializeResourceUsageChart(initialUsed, initialTotal);

        // 2. DROPDOWN CHANGE HANDLER
        $('#company-select').change(function () {
            var selectedCompanyId = $(this).val();
            var loader = $('#loader');
            // Check if a valid company ID is selected
            if (selectedCompanyId && selectedCompanyId !== "") {

                $('#resource_usage_chart').hide();
                loader.show();

                $.ajax({
                    type: 'GET',
                    url: '/CustomerManagement/GetResourceUsageData', // Make sure this URL is correct
                    data: { companyId: selectedCompanyId },
                    dataType: 'json',
                    success: function (data) {
                        
                        // --- WORKING LOGIC ---
                        // Re-initialize the chart every time to ensure the redraw and total calculation is correct.
                        initializeResourceUsageChart(data.employeeUsed, data.employeeTotal);

                        $('#resource_usage_chart').show();
                    },
                    error: function (xhr, status, error) {
                        console.error("AJAX Error:", status, error);
                        $('#resource_usage_chart').html('<p class="text-danger">Failed to load resource usage data.</p>').show();
                    },
                    complete: function () {
                        loader.hide();
                    }
                });
            } else {
                $('#resource_usage_chart').hide();
                loader.hide();
            }
        });
    });
</script>
