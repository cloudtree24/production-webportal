    <div class="section_gap_large">
      <div class="container">
        <div class="row">
          <div class="col-md-6">
            <div class="PositionSticky">
              <figure class="text-center">
                <img width="710" class="img-fluid" src="./assests/images/register.avif" alt="" title="Login">
              </figure>

              <div class="logIn-screen-testimonial owl-carousel">

                <!-- Slide 1 -->
                <div class="item text-center">
                  <p class="text-muted">Secure, Scalable, and Easy-to-Use</p>
                </div>
                <div class="item text-center">
                  <p class="text-muted">Automate Payroll and Compliance</p>
                </div>
                <div class="item text-center">
                  <p class="text-muted">Intelligent Reporting and Insights</p>
                </div>
                <div class="item text-center">
                  <p class="text-muted">Seamless Onboarding and Beyond</p>
                </div>
                <div class="item text-center">
                  <p class="text-muted">Unlock Effortless HR Management</p>
                </div>
              </div>
            </div>

          </div>

          <div class="col-md-6">
            <div class="login-wrapper">
              <div class="login-content rounded-custom border w-100">
                <h4 class="fw-bold">Register</h4>
                <p class="text-muted">Create New ThecloudTree HRMS Account</p>

                <form action="index.html">
                  <div class="row g-3">
                    <div class="col-md-12">
                      <label class="form-label">Company Name <span class="text-danger">*</span></label>
                      <div class="input-group">
                        <input type="text" class="form-control border-end-0" placeholder="Company Name" required>
                        <span class="input-group-text no-bg">
                          <i class="bi bi-building"></i>
                        </span>
                      </div>
                    </div>
                    <div class="col-md-12">
                      <label class="form-label">Contact Person Name <span class="text-danger">*</span></label>
                      <div class="input-group">
                        <input type="text" class="form-control border-end-0" placeholder="Contact Person Name" required>
                        <span class="input-group-text no-bg">
                          <i class="bi bi-person"></i>
                        </span>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Email Address <span class="text-danger">*</span></label>
                      <div class="input-group">
                        <input type="email" class="form-control border-end-0" placeholder="Email Address" required>
                        <span class="input-group-text no-bg">
                          <i class="bi bi-envelope"></i>
                        </span>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Phone Number <span class="text-danger">*</span></label>
                      <div class="input-group">
                        <input type="tel" class="form-control border-end-0" placeholder="Phone Number" required>
                        <span class="input-group-text no-bg">
                          <i class="bi bi-telephone"></i>
                        </span>
                      </div>
                    </div>
                    <div class="col-md-12">
                      <label class="form-label">Industry <span class="text-danger">*</span></label>
                      <select class="form-select" required>
                        <option value="" disabled selected>Select Industry</option>
                        <option value="hospitality">Hospitality</option>
                        <option value="bank">Bank</option>
                        <option value="it">IT</option>
                        <option value="staffing">Staffing</option>
                        <option value="other">Other</option>
                      </select>
                    </div>
                    <div class="col-md-12">
                      <label class="form-label">Address <span class="text-danger">*</span></label>
                      <div class="input-group">
                        <input type="text" class="form-control border-end-0" placeholder="Address" required>
                        <span class="input-group-text no-bg">
                          <i class="bi bi-geo-alt"></i>
                        </span>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">City <span class="text-danger">*</span></label>
                      <div class="input-group">
                        <input type="text" class="form-control border-end-0" placeholder="City" required>
                        <span class="input-group-text no-bg">
                          <i class="bi bi-building"></i>
                        </span>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">State <span class="text-danger">*</span></label>
                      <div class="input-group">
                        <input type="text" class="form-control border-end-0" placeholder="State" required>
                        <span class="input-group-text no-bg">
                          <i class="bi bi-map"></i>
                        </span>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Country <span class="text-danger">*</span></label>
                      <div class="input-group">
                        <input type="text" class="form-control border-end-0" placeholder="Country" required>
                        <span class="input-group-text no-bg">
                          <i class="bi bi-globe"></i>
                        </span>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Postal Code <span class="text-danger">*</span></label>
                      <div class="input-group">
                        <input type="text" class="form-control border-end-0" placeholder="Postal Code" required>
                        <span class="input-group-text no-bg">
                          <i class="bi bi-mailbox"></i>
                        </span>
                      </div>
                    </div>

                    <div class="col-md-12">
                      <div class="d-flex align-items-center justify-content-between">
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox" value="" id="checkDefault">
                          <label class="form-check-label text-muted" for="checkDefault">
                            I agree to the <span class="text-danger">terms & privacy</span>
                          </label>
                        </div>
                      </div>
                    </div>

                    <div class="col-12 mt-3">
                      <a href="checkout.html" class="btn btn-primary w-100 btn-lg">Register</a>
                    </div>
                    <div class="col-12 mt-3">
                      <p class="text-muted">Already have an account? <a href="login.html" class="text-primary">Sign
                          In</a>
                      </p>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          </div>

        </div>
      </div>
