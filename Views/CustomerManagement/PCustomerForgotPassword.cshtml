        if ($(this).scrollTop() > 500) {
            $('.scroll-to-top').fadeIn('slow');
        } else {
            $('.scroll-to-top').fadeOut('slow');
        }
    });
    $('.scroll-to-top').click(function () {
        $('html, body').animate({ scrollTop: 0 }, 500, 'easeInOutExpo');
        return false;
    });

</script>

